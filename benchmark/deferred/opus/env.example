# Additional variables needed only when the deferred Opus runs are enabled.

# Direct upstream Anthropic credential used by Pi/Claude Code and by the
# dedicated Codex Responses->Anthropic bridge for its outbound request.
ANTHROPIC_API_KEY=

# Bridge-local authentication token chosen by us, not an Anthropic key.
CODEX_OPUS_RESPONSES_API_KEY=

# HTTPS /v1 endpoint exposing benchmark/bridges/codex-opus to Pier containers.
# It must not point at the shared LiteLLM gateway.
CODEX_OPUS_RESPONSES_BASE_URL=https://opus-responses-bridge.example/v1
