# Additional variables needed only when the deferred Opus runs are enabled.

# Direct upstream Anthropic credential. Pi and Claude Code use it to reach
# api.anthropic.com, and the CLIProxyAPI bridge uses it for Codex's outbound
# Anthropic Messages requests.
ANTHROPIC_API_KEY=

# Nothing else is required. Codex reaches Opus through the same
# benchmark/bridges/codex-cliproxy deployment as DeepSeek and Kimi, using the
# CODEX_CLIPROXY_* variables already in benchmark/env.local. Regenerate with
# --include-opus so claude-opus-5 is added to the bridge's routes, then restart
# the bridge.
