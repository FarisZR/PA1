# Shared LiteLLM gateway. These aliases are used for GPT-5.6 Luna,
# DeepSeek V4 Flash 0731, and Kimi K3.
LITELLM_API_KEY=
LITELLM_OPENAI_BASE_URL=https://llm-gateway.example/v1

# Claude Code talks to the same LiteLLM gateway through its Anthropic-compatible
# surface for non-Anthropic benchmark models. The gateway must expose the exact
# [1m] aliases used in benchmark/configs/claude-code.yaml.
LITELLM_ANTHROPIC_BASE_URL=https://llm-gateway.example

# Claude Opus 5 uses the upstream Anthropic API directly in Pi, Claude Code,
# and OpenCode. This is also the upstream credential for the dedicated Codex
# Responses-to-Anthropic bridge; Opus must not be routed through the shared
# LiteLLM gateway.
ANTHROPIC_API_KEY=

# Codex cannot emit Anthropic Messages directly. Point these at a dedicated
# Responses-compatible bridge whose only model route is claude-opus-5 -> the
# upstream Anthropic API. The bridge itself is configured with ANTHROPIC_API_KEY.
CODEX_OPUS_RESPONSES_API_KEY=
CODEX_OPUS_RESPONSES_BASE_URL=https://opus-responses-bridge.example/v1
