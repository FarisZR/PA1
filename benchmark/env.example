# Current runnable benchmark: Luna, DeepSeek V4 Flash 0731, and Kimi K3.
# The repository does not modify the existing LiteLLM deployment.

# OpenAI-compatible LiteLLM surface used by Pi and Codex.
# Required aliases:
#   gpt-5.6-luna
#   deepseek-v4-flash   (all harnesses; routes to the 0731 checkpoint)
#   kimi-k3
LITELLM_API_KEY=
LITELLM_OPENAI_BASE_URL=https://llm-gateway.example/v1

# Anthropic-compatible surface of the same gateway, used by Claude Code.
# Claude Code configures [1m] model IDs locally for context-window metadata, then
# removes the suffix before sending requests. The gateway needs the canonical
# unsuffixed aliases listed above, not separate [1m] aliases.
LITELLM_ANTHROPIC_BASE_URL=https://llm-gateway.example

# PEM bundle of private CA roots that the trial containers must trust.
#
# Required whenever the gateway is served with a private certificate. On the
# current runner the gateway terminates at gklitellm-live.server.lan behind
# gkproxy, with a certificate issued by the internal IONOS PUKI CA. The host
# trusts it; a freshly built container does not, so without this every trial
# fails its first model call with an unverifiable-certificate error and the
# failure looks like a harness fault rather than a trust fault.
#
# The public bundle is tracked in this repository and contains both:
#   PUKI Root CA 2022 RSA
#   PUKI Root CA 2022 EC
# Source: https://pub.pki.1and1.org/
#
# Give an absolute path; Pier does not expand ~. Pier merges the bundle into the
# sandbox trust store and exports SSL_CERT_FILE, REQUESTS_CA_BUNDLE,
# CURL_CA_BUNDLE, GIT_SSL_CAINFO, NODE_EXTRA_CA_CERTS and CODEX_CA_CERTIFICATE
# for every agent. Leave empty only if the gateway uses a public CA.
PIER_EXTRA_CA_CERTS=/home/youruser/PA1/benchmark/puki-root-ca-2022.pem
