# Current runnable benchmark: Luna, DeepSeek V4 Flash 0731, Kimi K3, and GLM-5.3.
# The repository does not modify the existing LiteLLM deployment.

# OpenAI-compatible LiteLLM surface used by Pi and Codex.
# Required aliases:
#   gpt-5.6-luna
#   deepseek-v4-flash   (all harnesses; routes to the 0731 checkpoint)
#   kimi-k3
#   glm-5p3            (GLM-5.3)
LITELLM_API_KEY=
LITELLM_OPENAI_BASE_URL=https://llm-gateway.example/v1

# Anthropic-compatible surface of the same gateway, used by Claude Code.
# Claude Code configures [1m] model IDs locally for context-window metadata, then
# removes the suffix before sending requests. The gateway needs the canonical
# unsuffixed aliases listed above, not separate [1m] aliases.
LITELLM_ANTHROPIC_BASE_URL=https://llm-gateway.example

# PEM bundle of private CA roots that the trial containers must trust.
#
# Required whenever the gateway is served with a private certificate. On the
# current runner the gateway terminates at gklitellm-live.server.lan behind
# gkproxy, with a certificate issued by the internal IONOS PUKI CA. The host
# trusts it; a freshly built container does not, so without this every trial
# fails its first model call with an unverifiable-certificate error and the
# failure looks like a harness fault rather than a trust fault.
#
# The public bundle is tracked in this repository and contains both:
#   PUKI Root CA 2022 RSA
#   PUKI Root CA 2022 EC
# Source: https://pub.pki.1and1.org/
#
# Give an absolute path; Pier does not expand ~. Pier merges the bundle into the
# sandbox trust store and exports SSL_CERT_FILE, REQUESTS_CA_BUNDLE,
# CURL_CA_BUNDLE, GIT_SSL_CAINFO, NODE_EXTRA_CA_CERTS and CODEX_CA_CERTIFICATE
# for every agent. Leave empty only if the gateway uses a public CA.
PIER_EXTRA_CA_CERTS=/home/youruser/PA1/benchmark/puki-root-ca-2022.pem

# --- Codex compatibility bridge (benchmark/bridges/codex-cliproxy) -----------
# Codex 0.151.0 speaks only OpenAI Responses, and the gateway's Responses
# translation is rejected by the Fireworks-backed routes (PA1 issue #31).
# CLIProxyAPI translates Codex Responses into Chat Completions in front of the
# same gateway, and also carries the deferred Codex Opus route.
# Pi and Claude Code do not use it.

# /v1 endpoint of the bridge, as seen from inside a Pier trial container.
#
# Two hard constraints, both enforced by benchmark/scripts/prepare_configs.py:
#   * the port must be 80 (http) or 443 (https) - Pier's egress Squid denies
#     every other port, so CLIProxyAPI's own 8317 is unreachable;
#   * the host must be an IP address or an FQDN - Pier builds the Squid domain
#     allowlist from this hostname and discards dotless bare names.
#
# The default is the Docker bridge gateway. Every trial's egress-proxy container
# can reach it and it is not published on the LAN. Match CODEX_CLIPROXY_BIND.
CODEX_CLIPROXY_BASE_URL=http://172.17.0.1/v1

# Bridge-local token chosen by us. Codex authenticates to the bridge with it;
# the bridge holds LITELLM_API_KEY and ANTHROPIC_API_KEY and never forwards
# this one. Must not be one of CLIProxyAPI's own example keys.
CODEX_CLIPROXY_API_KEY=

# Host address and port the bridge container publishes on. Used only by
# benchmark/bridges/codex-cliproxy/compose.yaml and must agree with the host and
# port in CODEX_CLIPROXY_BASE_URL.
CODEX_CLIPROXY_BIND=172.17.0.1
CODEX_CLIPROXY_PORT=80

# Write full per-request logs, including the translated upstream body, to
# benchmark/generated/cliproxy-logs. Needed for the live acceptance check;
# leave false for benchmark jobs, where it records every prompt verbatim.
CODEX_CLIPROXY_REQUEST_LOG=false
