# Existing shared LiteLLM gateway. The benchmark does not modify this proxy.
# OpenAI-compatible aliases required by the current Pi/Codex runs:
#   gpt-5.6-luna
#   deepseek-v4-flash-0731
#   deepseek-v4-flash   (Pi only; must resolve to the same 0731 checkpoint)
#   kimi-k3
LITELLM_API_KEY=
LITELLM_OPENAI_BASE_URL=https://llm-gateway.example/v1

# Anthropic-compatible surface of the same LiteLLM gateway. Claude Code requires
# these exact aliases:
#   gpt-5.6-luna[1m]
#   deepseek-v4-flash-0731[1m]
#   kimi-k3[1m]
LITELLM_ANTHROPIC_BASE_URL=https://llm-gateway.example

# Direct upstream Anthropic credential. Opus 5 uses this directly in Pi and
# Claude Code. The dedicated Codex Opus bridge also uses it for its outbound
# request to api.anthropic.com.
ANTHROPIC_API_KEY=

# Codex cannot emit Anthropic Messages directly. CODEX_OPUS_RESPONSES_API_KEY is
# a private bridge-local token chosen by us (for example: openssl rand -hex 32).
# CODEX_OPUS_RESPONSES_BASE_URL is the HTTPS /v1 URL at which Pier containers can
# reach benchmark/bridges/codex-opus. It must not point at the shared LiteLLM
# gateway.
CODEX_OPUS_RESPONSES_API_KEY=
CODEX_OPUS_RESPONSES_BASE_URL=https://opus-responses-bridge.example/v1
