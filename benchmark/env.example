# Shared LiteLLM gateway. These aliases are used for GPT-5.6 Luna,
# DeepSeek V4 Flash 0731, and Kimi K3.
LITELLM_API_KEY=
LITELLM_OPENAI_BASE_URL=https://llm-gateway.example/v1

# Claude Code talks to the same LiteLLM gateway through its Anthropic-compatible
# surface for non-Anthropic benchmark models. Set this to the base URL expected
# by Claude Code (the gateway may use a different path than its OpenAI surface).
LITELLM_ANTHROPIC_BASE_URL=https://llm-gateway.example

# Claude Opus 5 uses the upstream Anthropic API directly in Pi, Claude Code,
# and OpenCode. Keep this credential separate from the LiteLLM gateway key.
ANTHROPIC_API_KEY=

# Codex only speaks the Responses protocol, so it cannot call Anthropic's
# Messages API directly. Point these at a Responses-compatible bridge that
# routes the claude-opus-5 alias to the upstream Anthropic API. Keep these
# separate from the normal LiteLLM variables so the exception is explicit.
CODEX_OPUS_RESPONSES_API_KEY=
CODEX_OPUS_RESPONSES_BASE_URL=https://opus-responses-bridge.example/v1
