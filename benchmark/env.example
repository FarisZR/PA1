# Current runnable benchmark: Luna, DeepSeek V4 Flash 0731, and Kimi K3.
# The repository does not modify the existing LiteLLM deployment.

# OpenAI-compatible LiteLLM surface used by Pi and Codex.
# Required aliases:
#   gpt-5.6-luna
#   deepseek-v4-flash-0731
#   deepseek-v4-flash   (Pi only; same 0731 checkpoint)
#   kimi-k3
LITELLM_API_KEY=
LITELLM_OPENAI_BASE_URL=https://llm-gateway.example/v1

# Anthropic-compatible surface of the same gateway, used by Claude Code.
# Required aliases:
#   gpt-5.6-luna[1m]
#   deepseek-v4-flash-0731[1m]
#   kimi-k3[1m]
LITELLM_ANTHROPIC_BASE_URL=https://llm-gateway.example
