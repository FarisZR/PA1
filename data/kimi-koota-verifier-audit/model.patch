+import type { $internal } from '../common';
+import type { Relation } from '../relation/types';
+import type { TagTrait, Trait, TraitRecord } from '../trait/types';
+import type { $aspect } from './symbols';
+
+type UnionToIntersection<U> = (U extends any ? (x: U) => void : never) extends (x: infer I) => void
+    ? I
+    : never;
+
+/** Schema of a constituent trait with tags normalized to empty objects. */
+type ConstituentSchema<T> =
+    T extends Trait<infer S> ? (S extends Record<string, never> ? {} : S) : never;
+
+/** Record of a constituent trait with tags normalized to empty objects. */
+type ConstituentRecord<T> =
+    T extends Trait<infer S> ? (S extends Record<string, never> ? {} : TraitRecord<S>) : never;
+
+/** The merged schema of all constituent traits in an aspect. */
+export type AspectSchema<TTraits extends Trait[]> = UnionToIntersection<
+    ConstituentSchema<TTraits[number]>
+>;
+
+/** The merged data record of all constituent traits in an aspect. */
+export type AspectRecord<TTraits extends Trait[]> = UnionToIntersection<
+    ConstituentRecord<TTraits[number]>
+>;
+
+/** Initial (or partial) values for an aspect, distributed to constituents by field. */
+export type AspectValue<TTraits extends Trait[]> = Partial<AspectRecord<TTraits>>;
+
+export type Aspect<TTraits extends Trait[] = Trait[]> = {
+    readonly [$aspect]: true;
+    /** Public read-only ID for fast lookups. Shared with the aspect's internal marker trait. */
+    readonly id: number;
+    /** The flattened constituent traits. */
+    readonly traits: Readonly<TTraits>;
+    /** The merged schema of all constituent fields. */
+    readonly schema: AspectSchema<TTraits>;
+    [$internal]: {
+        aspect: true;
+        id: number;
+        /** Hidden tag trait that is present exactly when all constituents are present. */
+        marker: TagTrait;
+        /** All constituent traits, flattened and deduplicated. */
+        traits: Trait[];
+        /** Non-tag constituents with their owned schema keys. */
+        parts: { trait: Trait; keys: string[] }[];
+        /** Lookup from constituent trait to its part (tags have no part). */
+        partByTrait: Map<Trait, { trait: Trait; keys: string[] }>;
+    };
+} & ((params?: AspectValue<TTraits>) => [Aspect<TTraits>, AspectValue<TTraits>]);
+
+/** Inputs accepted by createAspect. Nested aspects flatten to their traits. */
+export type AspectInput = Trait | Aspect;
+
+/** Inputs accepted by tracking modifiers (Added, Removed, Changed). */
+export type TrackableInput = Trait | Relation<Trait> | Aspect;
+
+/** Maps modifier inputs to the data they contribute to query state. Aspects stay aspects. */
+export type ExtractTrackables<T extends TrackableInput[]> = {
+    [K in keyof T]: T[K] extends Relation<infer TTrait> ? TTrait : T[K];
+};
+
+/** Flattens aspect inputs into their constituent traits at the type level. */
+export type FlattenAspectInputs<T extends AspectInput[]> = T extends [infer First, ...infer Rest]
+    ? [
+          ...(First extends Aspect<infer TTraits> ? TTraits : First extends Trait ? [First] : []),
+          ...(Rest extends AspectInput[] ? FlattenAspectInputs<Rest> : []),
+      ]
+    : [];
+
+export type AspectTuple<T extends Aspect = Aspect> = [
+    T,
+    T extends Aspect<infer TTraits> ? AspectValue<TTraits> : never,
+];
