@@ -0,0 +1,321 @@
+import { $internal } from '../common';
+import type { Entity } from '../entity/types';
+import { getEntityId } from '../entity/utils/pack-entity';
+import { isRelation, isRelationPair } from '../relation/utils/is-relation';
+import { hasTraitInstance } from '../trait/trait-instance';
+import {
+    addTrait,
+    getStore,
+    hasTrait,
+    registerTrait,
+    removeTrait,
+    setTrait,
+    trait,
+} from '../trait/trait';
+import type { Trait } from '../trait/types';
+import type { World } from '../world';
+import { $aspect } from './symbols';
+import type { Aspect, AspectInput, AspectValue, FlattenAspectInputs } from './types';
+import { isAspect } from './utils/is-aspect';
+
+/**
+ * Aspects are stateless, global refs (like traits). World-specific state is kept
+ * in sync through a hidden marker trait that is present exactly when an entity
+ * has every constituent trait.
+ *
+ * Registry of all created aspects, indexed two ways:
+ * - constituent trait -> aspects that contain it (for sync + change propagation)
+ * - marker trait -> owning aspect (for lazy per-world registration)
+ */
+const aspectsByConstituent = new Map<Trait, Aspect[]>();
+const aspectByMarker = new Map<Trait, Aspect>();
+
+export function createAspect<T extends AspectInput[]>(...inputs: T): Aspect<FlattenAspectInputs<T>> {
+    // Flatten nested aspects into their constituent traits, deduplicating.
+    const traits: Trait[] = [];
+    const seen = new Set<Trait>();
+
+    const push = (input: AspectInput) => {
+        if (isAspect(input)) {
+            // Nested aspects were validated at their own creation time.
+            for (const t of input[$internal].traits) {
+                if (!seen.has(t)) {
+                    seen.add(t);
+                    traits.push(t);
+                }
+            }
+            return;
+        }
+
+        if (isRelation(input) || isRelationPair(input)) {
+            throw new Error('Koota: Aspects cannot include relations.');
+        }
+
+        const t = input as Trait;
+        const traitCtx = t?.[$internal];
+
+        if (!traitCtx || !traitCtx.createStore) {
+            throw new Error('Koota: Aspect constituents must be traits.');
+        }
+        if (traitCtx.relation !== null) {
+            throw new Error('Koota: Aspects cannot include relations.');
+        }
+        if (traitCtx.type === 'aos') {
+            throw new Error(
+                'Koota: Aspects cannot include AoS (callback-based) traits since their fields cannot be merged.'
+            );
+        }
+
+        if (!seen.has(t)) {
+            seen.add(t);
+            traits.push(t);
+        }
+    };
+
+    for (const input of inputs) push(input);
+
+    if (traits.length < 2) {
+        throw new Error('Koota: createAspect requires at least two distinct traits.');
+    }
+
+    // Build the merged schema and field ownership. Overlapping fields are ambiguous
+    // for set/add distribution, so they are rejected eagerly.
+    const schema: Record<string, unknown> = {};
+    const fieldOwners = new Map<string, Trait>();
+    const parts: { trait: Trait; keys: string[] }[] = [];
+    const partByTrait = new Map<Trait, { trait: Trait; keys: string[] }>();
+
+    for (const t of traits) {
+        if (t[$internal].type === 'tag') continue;
+
+        const keys = Object.keys(t.schema);
+        const part = { trait: t, keys };
+        parts.push(part);
+        partByTrait.set(t, part);
+
+        for (const key of keys) {
+            if (fieldOwners.has(key)) {
+                throw new Error(`Koota: Aspect constituents have overlapping field "${key}".`);
+            }
+            fieldOwners.set(key, t);
+            schema[key] = (t.schema as Record<string, unknown>)[key];
+        }
+    }
+
+    // The marker is a hidden tag trait used to integrate aspects with the
+    // existing query tracking and event machinery. It is present on an entity
+    // exactly when all constituent traits are present.
+    const marker = trait();
+
+    const Aspect = Object.assign((params?: AspectValue<Trait[]>) => [Aspect, params], {
+        [$aspect]: true,
+        [$internal]: {
+            aspect: true,
+            id: marker.id,
+            marker,
+            traits,
+            parts,
+            partByTrait,
+        },
+    }) as unknown as Aspect<FlattenAspectInputs<T>>;
+
+    // Add public read-only properties, mirroring traits.
+    Object.defineProperty(Aspect, 'id', {
+        value: marker.id,
+        writable: false,
+        enumerable: true,
+        configurable: false,
+    });
+
+    Object.defineProperty(Aspect, 'traits', {
+        value: Object.freeze(traits.slice()),
+        writable: false,
+        enumerable: true,
+        configurable: false,
+    });
+
+    Object.defineProperty(Aspect, 'schema', {
+        value: Object.freeze(schema),
+        writable: false,
+        enumerable: true,
+        configurable: false,
+    });
+
+    // Register lookups.
+    for (const t of traits) {
+        const list = aspectsByConstituent.get(t);
+        if (list) list.push(Aspect);
+        else aspectsByConstituent.set(t, [Aspect]);
+    }
+    aspectByMarker.set(marker, Aspect);
+
+    return Aspect;
+}
+
+export function getAspectsForConstituent(trait: Trait): Aspect[] | undefined {
+    return aspectsByConstituent.get(trait);
+}
+
+export function getAspectByMarker(marker: Trait): Aspect | undefined {
+    return aspectByMarker.get(marker);
+}
+
+/**
+ * Returns true when the entity has every constituent trait.
+ */
+export function hasAspect(world: World, entity: Entity, aspect: Aspect): boolean {
+    const traits = aspect[$internal].traits;
+    for (let i = 0; i < traits.length; i++) {
+        if (!hasTrait(world, entity, traits[i])) return false;
+    }
+    return true;
+}
+
+/**
+ * Returns a merged object of all constituent fields,
+ * or undefined if any constituent is missing.
+ */
+export function getAspect(
+    world: World,
+    entity: Entity,
+    aspect: Aspect
+): Record<string, unknown> | undefined {
+    if (!hasAspect(world, entity, aspect)) return undefined;
+
+    const parts = aspect[$internal].parts;
+    const eid = getEntityId(entity);
+    const result: Record<string, unknown> = {};
+
+    for (let i = 0; i < parts.length; i++) {
+        const part = parts[i];
+        Object.assign(result, part.trait[$internal].get(eid, getStore(world, part.trait)));
+    }
+
+    return result;
+}
+
+/**
+ * Distributes each field of the value to its owning constituent trait,
+ * triggering change detection per constituent that received a field.
+ */
+export function setAspect(
+    world: World,
+    entity: Entity,
+    aspect: Aspect,
+    value: any,
+    triggerChanged = true
+) {
+    if (value instanceof Function) value = value(getAspect(world, entity, aspect));
+    if (!value) return;
+
+    const ctx = world[$internal];
+    const parts = aspect[$internal].parts;
+
+    for (let i = 0; i < parts.length; i++) {
+        const { trait: partTrait, keys } = parts[i];
+
+        let owns = false;
+        for (let k = 0; k < keys.length; k++) {
+            if (keys[k] in value) {
+                owns = true;
+                break;
+            }
+        }
+        if (!owns) continue;
+
+        // Register the constituent lazily so its store exists,
+        // mirroring the behavior of change detection.
+        if (!hasTraitInstance(ctx.traitInstances, partTrait)) registerTrait(world, partTrait);
+
+        // SoA set functions only write owned keys present in the value.
+        setTrait(world, entity, partTrait, value, triggerChanged);
+    }
+}
+
+/**
+ * Adds only the constituents the entity does not already have,
+ * distributing initial values to constituents by field.
+ */
+export function addAspectConstituents(
+    world: World,
+    entity: Entity,
+    aspect: Aspect,
+    params?: Record<string, any>
+) {
+    const aspectCtx = aspect[$internal];
+    const traits = aspectCtx.traits;
+
+    for (let i = 0; i < traits.length; i++) {
+        const t = traits[i];
+        if (hasTrait(world, entity, t)) continue;
+
+        const part = aspectCtx.partByTrait.get(t);
+
+        if (part && params) {
+            let sub: Record<string, any> | undefined;
+            const keys = part.keys;
+            for (let k = 0; k < keys.length; k++) {
+                const key = keys[k];
+                if (key in params) (sub ??= {})[key] = params[key];
+            }
+            if (sub) {
+                addTrait(world, entity, [t, sub] as any);
+                continue;
+            }
+        }
+
+        addTrait(world, entity, t);
+    }
+}
+
+/**
+ * Removes all constituent traits from the entity.
+ */
+export function removeAspectConstituents(world: World, entity: Entity, aspect: Aspect) {
+    const traits = aspect[$internal].traits;
+    for (let i = 0; i < traits.length; i++) {
+        removeTrait(world, entity, traits[i]);
+    }
+}
+
+/**
+ * Keeps aspect marker traits in sync after a constituent trait was added to or
+ * removed from an entity. Fires marker add/remove subscriptions so aspect-level
+ * events behave like trait-level events.
+ */
+export function syncAspectMarkers(world: World, entity: Entity, trait: Trait) {
+    const aspects = aspectsByConstituent.get(trait);
+    if (!aspects) return;
+
+    for (let i = 0; i < aspects.length; i++) {
+        const aspect = aspects[i];
+        const marker = aspect[$internal].marker;
+
+        // The marker is a regular tag trait, so adding/removing it through the
+        // public path updates queries, tracking masks and fires subscriptions.
+        if (hasAspect(world, entity, aspect)) {
+            if (!hasTrait(world, entity, marker)) addTrait(world, entity, marker);
+        } else if (hasTrait(world, entity, marker)) {
+            removeTrait(world, entity, marker);
+        }
+    }
+}
+
+/**
+ * Brings a world that has never seen this aspect up to date by adding markers
+ * to all pre-existing entities that already have every constituent. Runs once
+ * per world when the marker trait is lazily registered.
+ */
+export function syncAspectMarkersForWorld(world: World, aspect: Aspect) {
+    const ctx = world[$internal];
+    const marker = aspect[$internal].marker;
+    const { dense, aliveCount } = ctx.entityIndex;
+
+    for (let i = 0; i < aliveCount; i++) {
+        const entity = dense[i];
+        if (!hasAspect(world, entity, aspect)) continue;
+        if (hasTrait(world, entity, marker)) continue;
+        // No subscriptions can exist yet since the marker is only registered now.
+        addTrait(world, entity, marker);
+    }
+}
